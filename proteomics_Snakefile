# PeptideShaker
#########################
# http://compomics.github.io/projects/peptide-shaker

rule peptideshaker_download:
    output:
        archive=temp(os.path.join(BINDIR, "PeptideShaker_%s.zip" % config["peptideshaker"]["version"])),
        jar=PEPTIDESHAKER_JAR
    log:
        "logs/PeptideShaker_download.log"
    params:
        runtime = "01:00:00",
        mem = MEMCORE,
        url = config["peptideshaker"]["url"].format(version=config["peptideshaker"]["version"])
    threads: 1
    message:
        "Downloading PeptideShaker from {params.url}"
    shell:
        "wget -O {output.archive} {params.url} &> {log} && "
        "unzip {output.archive} -d {BINDIR} &>> {log}"

rule peptideshaker_load:
    input:
        searchgui=SEARCHGUI_ZIP,
        jar=PEPTIDESHAKER_JAR
    output:
        PEPTIDESHAKER_ZIP
    log:
        "logs/PeptideShaker_load.log"
    params:
        runtime = "01:00:00",
        mem = MEMCORE
    threads: 10
    conda:
        os.path.join(ENVDIR, "IMP_proteomics.yaml")
    message:
        "PeptideShaker load SearchGUI results: {input.searchgui}"
    shell:
        "java -Xmx{params.mem} -cp {input.jar} eu.isas.peptideshaker.cmd.PeptideShakerCLI "
        "-identification_files {input.searchgui} -experiment 'peptideshaker' -sample 'peptideshaker' -replicate 1 "
        "-zip {output} -threads {threads} &> {log}"

rule peptideshaker_report:
    input:
        archive=PEPTIDESHAKER_ZIP,
        jar=PEPTIDESHAKER_JAR
    output:
        PEPTIDESHAKER_REPORT
    log:
        "logs/PeptideShaker_report.log"
    params:
        runtime = "01:00:00",
        mem = MEMCORE
    threads: 10
    conda:
        os.path.join(ENVDIR, "IMP_proteomics.yaml")
    message:
        "PeptideShaker report: {input.archive}"
    shell:
        "java -Xmx{params.mem} -cp {input.jar} eu.isas.peptideshaker.cmd.ReportCLI -in {input.archive} -out_reports $(dirname {output}) -reports 6,9 &> {log} && "
        "touch {output}"
