##################################################
# SHELL
##################################################

# default executable for snakmake
shell.executable("bash")

##################################################
# PATHS
##################################################
# default configuration file
configfile:
    srcdir("config/config.proteomics.yaml")

# relevant paths
SRCDIR      = srcdir("workflow/scripts")
BINDIR      = srcdir("workflow/bin")
ENVDIR      = srcdir("workflow/envs")
MODULDIR    = srcdir("submodules")
OUTPUTDIR   = os.environ.get("OUTPUTDIR", config['outputdir'])
TMPDIR      = os.environ.get("TMPDIR", config['tmp_dir'])
DBPATH      = os.environ.get("DBPATH", os.path.expandvars(config['db_path']))

##################################################
# WORKDIR
##################################################
workdir:
    OUTPUTDIR

##################################################
# CONFIG
##################################################
# merge configs: default and custom
config = extend_config(config, os.environ.get("CONFIGFILE", os.path.join(srcdir("config"), "userconf.proteomics.yaml")))

# validate config
validate(config, schema=os.path.join(srcdir("schemas"), "schema.proteomics.yaml"))

# save config
dump_config(config, os.path.join(OUTPUTDIR, "proteomics.config.yaml"))

##################################################
# HARDWARE
##################################################
BIGCORENO, BIGMEMTOTAL, MEMCORE, BIGMEMCORE = get_hardware(config)

##################################################
# DATA
##################################################
# create diretories
create_db_dir(DBPATH)
create_tmp_dir(TMPDIR, OUTPUTDIR)

# sample
SAMPLE = get_sample(config, OUTPUTDIR)

# input files
PROTEINS = os.environ.get("PROTEINS", config["raws"]["Proteins"])
THERMORAW = os.environ.get("THERMORAW", config["raws"]["ThermoRaw"])

##################################################
# RULES
##################################################
localrules: prepare_input_data, ALL

rule ALL:
    input:
        data=["proteins.faa", "thermo.raw"],
        thermo=["thermo.mgf", "thermo-metadata.json"],
        searchgui=["searchgui.par"],

rule prepare_input_data:
    input:
        PROTEINS,
        THERMORAW
    output:
        "proteins.faa",
        "thermo.raw"
    threads: 1
    message: "Preparing input."
    run:
        prepare_input_files(input, output)

# https://github.com/compomics/ThermoRawFileParser
rule thermorawfileparser:
    input:
        "thermo.raw"
    output:
        mgf="thermo.mgf",
        json="thermo-metadata.json"
    log:
        "logs/ThermoRawFileParser.log"
    params:
        runtime = "01:00:00", # TODO
        mem = MEMCORE
    threads: 1
    conda:
        os.path.join(ENVDIR, "IMP_proteomics.yaml")
    message:
        "ThermoRawFileParser: {input} -> {output}"
    shell:
        "mono ${{CONDA_PREFIX}}/bin/ThermoRawFileParser.exe -i={input} -o=$(dirname {output[0]}) -f=0 -m=0 &> {log}"

# http://compomics.github.io/projects/searchgui.html
rule searchgui_config:
    input:
        "proteins.faa"
    output:
        "searchgui.par"
    log:
        "logs/SearchGUI_params.log"
    params:
        runtime = "01:00:00", # TODO
        mem = MEMCORE
    threads: 1
    conda:
        os.path.join(ENVDIR, "IMP_proteomics.yaml")
    message:
        "Prepare parameter file for SearchGUI: {input} -> {output}"
    shell:
        """
        JAR=$(find ${{CONDA_PREFIX}} -type f -name "SearchGUI*.jar" | head -n 1)
        echo "SearchGUI: ${{JAR}}"
        if [ -z "${{JAR}}" ]
        then
            echo "Could not find the JAR file for SearchGUI in ${{CONDA_PREFIX}}"
        else
            java -Xmx{params.mem} -cp ${{JAR}} eu.isas.searchgui.cmd.IdentificationParametersCLI \
            -out {output} \
            -db {input} \
            -prec_tol 10 \
            -prec_ppm 1 \
            -frag_tol 0.5 \
            -frag_ppm 0 \
            -digestion 0 \
            -enzyme "Trypsin" \
            -specificity 0 \
            -mc 1 \
            -fixed_mods "Carbamidomethylation of C" \
            -variable_mods "Oxidation of M" \
            -min_charge 2 \
            -max_charge 4 \
            -fi "b" \
            -ri "y" \
            -min_isotope 0 \
            -max_isotope 1 \
            -import_peptide_length_min 7 \
            -import_peptide_length_max 50 \
            -xtandem_noise_suppr 0 \
            -xtandem_quick_acetyl 1 \
            -xtandem_quick_pyro 1 \
            -xtandem_refine 1 \
            -msgf_instrument 1 \
            -msgf_fragmentation 1 \
            -msgf_protocol 0 \
            -msgf_min_pep_length 7 \
            -msgf_min_pep_length 50 \
            -msgf_num_ptms 3 \
            -comet_num_ptms 3
        fi
        """

