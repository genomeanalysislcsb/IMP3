#########################
# Input data
#########################
rule prepare_input_data:
    input:
        I_PROTEINS,
        I_THERMORAW
    output:
        PROTEINS,
        THERMORAW
    threads: 1
    message: "Preparing input."
    run:
        prepare_input_files(input, output)

rule proc_faa:
    input:
        PROTEINS
    output:
        PROTEINS_PROC
    log:
        "logs/proteins_processing.log"
    params:
        runtime = "01:00:00",
        mem = MEMCORE
    message:
        "Processing proteins FASTA: {input} => {output}"
    run:
        with open(log[0], "w") as lfile, open(input[0], "r") as ifile, open(output[0], "w") as ofile:
            record = ""
            for line in ifile:
                # new record starts
                if re.match(">", line):
                    # save last record
                    if record != "":
                        ofile.write(record)
                    # start new record
                    record = line
                # seq.
                else:
                    # seq. was okay so far
                    if record != "":
                        # found "*" in seq. (not last char): skip this record
                        if re.search("\*(?!$)", line):
                            lfile.write("Found '*' in %s: skipping\n" % record.split("\n")[0])
                            record = ""
                        # record is still okay: save seq.
                        else:
                            record += line


#########################
# ThermoRawFileParser
#########################
# https://github.com/compomics/ThermoRawFileParser
rule thermorawfileparser:
    input:
        "thermo/thermo__{bname}.raw"
    output:
        "thermo/thermo__{bname}.mgf"
    log:
        "logs/ThermoRawFileParser__{bname}.log"
    wildcard_constraints:
        bname="|".join(THERMORAW_NAMES)
    params:
        runtime = "01:00:00", # TODO
        mem = MEMCORE
    threads: 1
    conda:
        os.path.join(ENVDIR, "IMP_proteomics.yaml")
    message:
        "ThermoRawFileParser: {input} -> {output}"
    shell:
        "mono ${{CONDA_PREFIX}}/bin/ThermoRawFileParser.exe -i={input} -o=$(dirname {output}) -f=0 -m=0 &> {log}"

#########################
# SearchGUI
#########################
# http://compomics.github.io/projects/searchgui/wiki/SearchCLI
# https://github.com/compomics/searchgui

rule searchgui_download:
    output:
        archive=temp(os.path.join(BINDIR, "SearchGUI_%s.zip" % config["peptideshaker"]["version"])),
        jar=SEARCHGUI_JAR
    log:
        "logs/SearchGUI_download.log"
    params:
        runtime = "01:00:00",
        mem = MEMCORE,
        url = config["searchgui"]["url"].format(version=config["searchgui"]["version"])
    threads: 1
    message:
        "Downloading SearchGUI from {params.url}"
    shell:
        "wget -O {output.archive} {params.url} &> {log} && "
        "tar -xzvf {output.archive} -C {BINDIR} &>> {log}"

rule searchgui_decoy:
    input:
        faa=PROTEINS_PROC,
        jar=SEARCHGUI_JAR
    output:
        PROTEINS_DECOY
    log:
        "logs/SearchGUI_decoy.log"
    params:
        runtime = "01:00:00",
        mem = MEMCORE,
        tmpdir = TMPDIR,
        logdir = "logs/SearchGUI_decoy"
    threads: 1
    conda:
        os.path.join(ENVDIR, "IMP_proteomics.yaml")
    message:
        "SearchGUI decoy: {input} -> {output}"
    shell:
        "java -Xmx{params.mem} -cp {input.jar} eu.isas.searchgui.cmd.FastaCLI -in {input.faa} -decoy -temp_folder {params.tmpdir} -log {params.logdir} &> {log}"

rule searchgui_config:
    input:
        fasta=PROTEINS_DECOY,
        jar=SEARCHGUI_JAR
    output:
        SEARCHGUI_PAR
    log:
        "logs/SearchGUI_params.log"
    params:
        runtime = "01:00:00",
        mem = MEMCORE,
        params = SEARCHGUI_PAR_PARAMS,
        tmpdir = TMPDIR,
        logdir = "logs/SearchGUI_params"
    threads: 1
    conda:
        os.path.join(ENVDIR, "IMP_proteomics.yaml")
    message:
        "SearchGUI parameters: {input} -> {output}"
    shell:
        "java -Xmx{params.mem} -cp {input.jar} eu.isas.searchgui.cmd.IdentificationParametersCLI -out {output} -db {input.fasta} "
        "{params.params} -temp_folder {params.tmpdir} -log {params.logdir} &> {log}"

rule searchgui_search:
    input:
        par=SEARCHGUI_PAR,
        mgf=THERMOMGF,
        jar=SEARCHGUI_JAR
    output:
        SEARCHGUI_ZIP
    log:
        "logs/SearchGUI_search.log"
    params:
        runtime = "01:00:00",
        mem = MEMCORE,
        tmpdir = TMPDIR,
        logdir = "logs/SearchGUI_search"
    threads: 10
    conda:
        os.path.join(ENVDIR, "IMP_proteomics.yaml")
    message:
        "SearchGUI search: {input.par}, {input.mgf}"
    shell:
        """
        java -Xmx{params.mem} -cp {input.jar} eu.isas.searchgui.cmd.SearchCLI \
            -spectrum_files $(dirname {input.mgf[0]}) \
            -output_folder $(dirname {output}) \
            -id_params {input.par} \
            -xtandem 1 \
            -msgf 1 \
            -comet 1 \
            -andromeda 0 \
            -threads {threads} \
            -output_default_name "searchgui" \
            -output_option 0 \
            -output_data 1 \
            -output_date 0 \
            -log {params.logdir} \
            &> {log} && touch {output}
        """

