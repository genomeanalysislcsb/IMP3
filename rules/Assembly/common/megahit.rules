MEGAHIT_ASSEMBLY_SHELL = """
#echo "[x] Performing {wildcards.type} assembly step '{wildcards.loop}' using MEGAHIT"
if [ -d "{params.outdir}" ]; then
    rm -rf {params.outdir}
fi
MAX_MEM="$(({BIGMEMTOTAL} * 1000000000))"
megahit -1 {input[0]} \
 -2 {input[1]} \
 -r {input[2]} \
 -o {output[0]} \
 --k-min {config[assembly][mink]} \
 --k-max {config[assembly][maxk]} \
 --k-step {config[assembly][step]} \
 --no-bubble \
 -t {threads} --cpu-only \
 -m "${{MAX_MEM}}" \
 --mem-flag 1
ln -fs $(echo {output[1]} | cut -f 2,3 -d /) {output[2]} && touch -h {output[2]}
"""

rule megahit_assembly_from_preprocessing:
    input:
        'Preprocessing/{type}.r1.preprocessed.fq',
        'Preprocessing/{type}.r2.preprocessed.fq',
        'Preprocessing/{type}.se.preprocessed.fq'
    output:
        directory('Assembly/{type}.megahit_preprocessed.{loop}'),
        'Assembly/{type}.megahit_preprocessed.{loop}/final.contigs.fa',
        'Assembly/{type}.megahit_preprocessed.{loop}.fa'
    params:
        runtime = "120:00:00",
        partition = "-p bigmem --qos qos-bigmem ",
        mem = "--mem=" + BIGMEMTOTAL + "G"
    threads: BIGCORENO
    conda: "envs/IMP_assembly.yaml"
    log: "logs/assembly_fromPreprocessing.{type}.log"
    message: "Performing {type} assembly step {loop} from preprocessed reads using MEGAHIT"
    shell:
        MEGAHIT_ASSEMBLY_SHELL


rule megahit_assembly_from_unmapped:
    input:
        'Assembly/{type}.r1.unmapped.fq',
        'Assembly/{type}.r2.unmapped.fq',
        'Assembly/{type}.se.unmapped.fq'
    output:
        directory('Assembly/{type}.megahit_unmapped.{loop}'),
        'Assembly/{type}.megahit_unmapped.{loop}/final.contigs.fa',
        'Assembly/{type}.megahit_unmapped.{loop}.fa'
    params:
        runtime = "120:00:00",
        partition = "-p bigmem --qos qos-bigmem ",
        mem = "--mem=" + BIGMEMTOTAL + "G"
    threads: BIGCORENO
    conda: "envs/IMP_assembly.yaml"
    log: "logs/assembly_fromUnmapped.{type}.log"
    message: "Performing {type} assembly step {loop} from unmapped reads using MEGAHIT"
    shell:
        MEGAHIT_ASSEMBLY_SHELL
