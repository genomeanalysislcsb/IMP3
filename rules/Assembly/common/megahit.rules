MEGAHIT_ASSEMBLY_SHELL = """
if [ -d "{output[0]}" ]; then
    rm -rf {output[0]}
fi
MAX_MEM="$(({BIGMEMTOTAL} * 1000000000))"
megahit -1 {input[0]} \
 -2 {input[1]} \
 -r {input[2]} \
 -o {output[0]} \
 --k-min {config[assembly][mink]} \
 --k-max {config[assembly][maxk]} \
 --k-step {config[assembly][step]} \
 --bubble-level 0 \
 -t {threads} --cpu-only \
 -m "${{MAX_MEM}}" \
 --mem-flag 1
ln -fs $(echo {output[1]} | cut -f 2,3 -d /) {output[2]} && touch -h {output[2]}
"""

rule megahit_assembly_from_preprocessing:
    input:
        'Preprocessing/{type}.r1.preprocessed.fq',
        'Preprocessing/{type}.r2.preprocessed.fq',
        'Preprocessing/{type}.se.preprocessed.fq'
    output:
        directory('Assembly/{type}.megahit_preprocessed.1'),
        'Assembly/{type}.megahit_preprocessed.1/final.contigs.fa',
        'Assembly/{type}.megahit_preprocessed.1.fa'
    params:
        runtime = "120:00:00",
        mem = BIGMEMCORE
    threads: BIGCORENO
    conda: ROOT_DIR + "/envs/IMP_assembly.yaml"
    log: "logs/assembly_fromPreprocessing.{type}.log"
    message: "Performing {wildcards.type} assembly step 1 from preprocessed reads using MEGAHIT"
    shell:
        MEGAHIT_ASSEMBLY_SHELL

rule megahit_assembly_from_unmapped:
    input:
        'Assembly/{type}.r1.unmapped.fq',
        'Assembly/{type}.r2.unmapped.fq',
        'Assembly/{type}.se.unmapped.fq'
    output:
        directory('Assembly/{type}.megahit_unmapped.2'),
        'Assembly/{type}.megahit_unmapped.2/final.contigs.fa',
        'Assembly/{type}.megahit_unmapped.2.fa'
    params:
        runtime = "120:00:00",
        mem = BIGMEMCORE
    threads: BIGCORENO
    conda: ROOT_DIR + "/envs/IMP_assembly.yaml"
    log: "logs/assembly_fromUnmapped.{type}.log"
    message: "Performing {wildcards.type} assembly step 2 from unmapped reads using MEGAHIT"
    shell:
        MEGAHIT_ASSEMBLY_SHELL
