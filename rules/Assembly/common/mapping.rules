rule mapping_on_assembly:
    input:
        'Preprocessing/{type}.r1.preprocessed.fq',
        'Preprocessing/{type}.r2.preprocessed.fq',
        'Preprocessing/{type}.se.preprocessed.fq',
        'Assembly/%s.assembly.merged.fa' % ASS
    output:
        'Assembly/{type}.reads.sorted.bam',
        'Assembly/{type}.reads.sorted.bam.bai',
    params:
        runtime = "12:00:00",
        partition = "-p bigmem --qos qos-bigmem ",
        mem = "--mem=" + str(BIGMEMTOTAL) + "G"
    threads: BIGCORENO
    conda: ROOT_DIR + "/envs/IMP_mapping.yaml"
    log: "logs/assembly_mappingAssembly.{type}.log"
    message: "Mapping {wildcards.type} reads on merged assembly."
    shell:
        """
        SAMHEADER="@RG\\tID:{SAMPLE}\\tSM:MG"
        PREFIX=Assembly/{wildcards.type}.reads
        # index
        bwa index {input[3]}
        # merge paired and se
        samtools merge --threads {threads} -f $PREFIX.merged.bam \
         <(bwa mem -v 1 -t {threads} -M -R \"$SAMHEADER\" {input[3]} {input[0]} {input[1]} | \
         samtools view --threads {threads} -bS -) \
         <(bwa mem -v 1 -t {threads} -M -R \"$SAMHEADER\" {input[3]} {input[2]} | \
         samtools view --threads {threads} -bS -)
        # sort
        samtools sort --threads {threads} -m {BIGMEMCORE} $PREFIX.merged.bam > $PREFIX.sorted.bam
        rm $PREFIX.merged.bam
        # index
        samtools index $PREFIX.sorted.bam
        """
