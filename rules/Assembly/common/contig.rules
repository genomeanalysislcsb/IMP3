rule contig_fasta_indexing:
    input:
        "Assembly/%s.assembly.merged.fa" % ASS
    output:
        "Assembly/%s.assembly.merged.fa.fai" % ASS
    params:
        runtime = "8:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch"
    threads: 1
    conda: ROOTDIR + "/envs/IMP_mapping.yaml"
    log: "logs/assembly_fastaindex.log"
    message: "Indexing assembly."
    shell:
        """
        samtools faidx {input[0]}
        """

rule contig_fasta2bed_conversion:
    input:
        "Assembly/%s.assembly.merged.fa" % ASS,
        "Assembly/%s.assembly.merged.fa.fai" % ASS
    output:
        "Assembly/%s.assembly.merged.fa.bed3" % ASS
    params:
        runtime = "8:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch"
    threads: 1
    log: "logs/assembly_fastabed.log"
    message: "Writing bed file for assembly."
    shell:
        """
#       	cat {input[0]}.fai | perl -ane '@F=split(/[\\t\\s]+/,$_); print "$F[0]\\t0\\t$F[1]\\n";' > {input[1]}.bed3
        cat {input[0]}.fai | awk '{{print $1 \"\t0\t\" $2}}' > {input[1]}.bed3
        """
