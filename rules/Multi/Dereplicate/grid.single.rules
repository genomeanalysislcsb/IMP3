localrules: grid_simple_all

rule grid_simple_all:
    input: 
        gather_simple_bins
    output:
        "Dereplication/GRiD.done"
    shell:
        """
        touch {output}
        """

if not config['dereplication']['GTDBtk']:
    rule GRID_summarize:
        input:
            gather_simple_bins
        output:
            report("Stats/bins.tsv" ,category="Dereplication")
        params:
            runtime = "12:00:00",
            mem = MEMCORE
        log: "logs/dereplication_GRID_summarize.log"
        message: "GRID_summarize: Summarizing binning results."
        threads: 1
        conda: ENVDIR + "/IMP_binning.yaml"
        script:
            SRCDIR + "/multi_simple_summarize_GRID.R"    
    rule bins_tar:
        input:
            dir="Dereplication/dRep_single_out/perBin",
            ctrl="Stats/bins.tsv",
            bins=gather_simple_bins
        output:
            "Dereplication/dRep_single_out/per_bin_results.tar.gz"
        threads: 1
        params:
            runtime = "8:00:00",
            mem = MEMCORE
        log: "logs/dereplication_bins_tar.log"
        message: "bins_tar: Compressing per-bin results of GRiD."
        shell:
            """
            tar cvzf {output} {input.bins} && rm -r {input.bins} >> {log} 2>&1
            """

checkpoint getBins_simple:
    input: 
        "Dereplication/dRep_single_out/dereplicated_genomes"
    output:
        "Dereplication/GRiD.prepped"
    params:
        runtime = "4:00:00",
        mem = MEMCORE
    threads: 1
#    log: "logs/dereplication_getBins_simple.log"
    message: "getBins_simple: Copying dRep bins to single directories."
    shell:
        """
        for f in `ls {input}`
          do
          bin=${{f/.contigs.fa/}}
          mkdir -p Dereplication/dRep_single_out/perBin/$bin && cp {input}/$f Dereplication/dRep_single_out/perBin/$bin/contigs.fa
        done
        touch {output}
        """
    
rule grid:
    input:
       "Dereplication/dRep_single_out/{clusterID}/contigs.fa",
       "Dereplication/dRep_single_out/{clusterID}/reads.fastq"
    output:
        directory("Dereplication/dRep_single_out/{clusterID}/grid")
    params:
        clusterInput="Dereplication/dRep_single_out/",
        runtime = "24:00:00",
        mem = BIGMEMCORE
    threads: 1
    conda: ENVDIR + "/IMP_grid.yaml"
    log: "logs/dereplication_grid.{clusterID}.log"
    message: "grid: Running GRiD on {wildcards.clusterID}."
    shell:
        """
        grid single -r {params.clusterInput}{wildcards.clusterID} -o {output} -g {input[0]} > {log} 2>&1
        """

rule prepare_gridBed:
    input:
        "Dereplication/dRep_single_out/{clusterID}/contigs.fa"
    output:
        "Dereplication/dRep_single_out/{clusterID}/contigs.bed"
    params:
        runtime = "2:00:00",
        mem = MEMCORE
    threads: 1
    log: "logs/dereplication_prepare_gridBed.{clusterID}.log"
    message: "dereplication_gridBed: Preparing .bed file for GRiD - {wildcards.clusterID}."
    shell:
        """
        {SRCDIR}/fastaBed.pl {input} >> {output} 2> {log}
        """

rule prepare_gridReads:
    input:
        get_bam,
        "Dereplication/dRep_single_out/{clusterID}/contigs.bed"
    output:
        "Dereplication/dRep_single_out/{clusterID}/reads.fastq"
    params:
        runtime = "12:00:00",
        mem = BIGMEMCORE
    threads: 1
    log: "logs/dereplication_prepare_gridReads.{clusterID}.log"
    message: "dereplication_gridReads: Preparing fastq file for GRiD - {wildcards.clusterID}."
    conda: ENVDIR + "/IMP_mapping.yaml"
    shell:
        """
        samtools view -b -F 5 -L {input[1]} {input[0]} 2>> {log} | samtools bam2fq -n - > {output} 2>> {log} 
        samtools view -b -f 65 -F 4 -L {input[1]} {input[0]} 2>> {log} | samtools bam2fq -n - >> {output} 2>> {log}
        samtools view -b -f 129 -F 4 -L {input[1]} {input[0]} 2>> {log} | samtools bam2fq -n - >> {output} 2>> {log}
        """
