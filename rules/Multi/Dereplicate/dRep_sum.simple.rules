rule dRep_sum_simple:
    input:
        "Dereplication/dRep_single_out/data_tables/Widb.csv"
    output:
        report("Dereplication/all_bin_stats.tsv",category="Simple dereplication")
    threads: BIGCORENO
    params:
        runtime = "12:00:00",
        mem = MEMCORE
    log: "logs/dereplication_dRep_sum_simple.log"
    message: "dRep_sum_simple: Gathering data on dereplicated bins."
    shell:
        """
        cp {input} {output}
        """
