rule cat:
    input:
        expand("{raw_directory}/Analysis/annotation/prokka.ffn",
                raw_directory=samples.loc[samples.genes == 1 ,"path"])
    output:
        "Catalogue/multi_prokka.ffn"
    threads: 1
    params:
        runtime = "12:00:00",
        mem = MEMCORE
#    log: "logs/catalogue_cat.log"
    message: 'catalogue_cat: concatenating coding regions from " ".join(samples.loc[samples.genes == 1 ,"sample"]).'
    threads: 1
    shell:
        """
        cat {input} >> {output}
        """

rule mmSeqs:
    input:
        "Catalogue/multi_prokka.ffn"
    output:
        "Catalogue/catalogue_cluster.tsv",
        "Catalogue/catalogue.fasta"
    threads: 1
    params:
        runtime = "12:00:00",
        mem = BIGMEMCORE,
        tmp = TMPDIR,
        cat = "Catalogue/catalogue"
    log: "logs/catalogue_mmSeqs.log"
    message: 'catalogue_mmSeqs: clustering coding regions.'
    threads: 1
    conda: ENVDIR + "/IMP_multi.yaml"
    shell:
        """
        mmseqs easy-cluster {input} {params.cat} {params.tmp} --min-seq-id 0.95 -c 0.9 --cov-mode 1 >> {log} 2>&1
        mv {params.cat}_rep_seq.fasta {output[1]}
        """
       
rule cat_gff:
    input:
        "Catalogue/catalogue_cluster.tsv",
        expand("{raw_directory}/Analysis/annotation/annotation_CDS_RNA_hmms.gff",
                raw_directory=samples.loc[samples.genes == 1 ,"path"])
    output:
        "Catalogue/catalogue.gff"
    threads: 1
    params:
        runtime = "12:00:00",
        mem = MEMCORE,
        tmp = TMPDIR
    log: "logs/catalogue_cat_gff.log"
    message: 'collate_cat_gff: getting annotations for representative genes from individual gffs.'
    threads: 1
    script:
        SRCDIR + "/multi_extract_gff.py"
       
rule extract_representative:
    input:
        lambda wildcards: expand("{raw_directory}/Analysis/annotation/prokka.faa",
                raw_directory=samples.path[wildcards.sample]),
        "Catalogue/catalogue_cluster.tsv"
    output:
        temporary('Catalogue/{sample}.prokka.faa'),
        temporary('Catalogue/{sample}.prokka.faa.index'),
        temporary('Catalogue/{sample}.rep.names'),
        temporary('Catalogue/{sample}.rep.faa')
    params:
        runtime = "12:00:00",
        mem = MEMCORE,
        prok_p = lambda wildcards: samples.prokka_prefix[wildcards.sample] + "_"
    threads: 1
    conda: ENVDIR + "/IMP_bioperl.yaml"
    log: "logs/catalogue_extract_representative.{sample}.log"
    message: "extract_representative: Extracting representative amino acid sequences from {wildcards.sample}."
    shell:
        """
        cp {input[0]} {output[0]}
        cut -f 1 {input[1]} | sort | uniq | grep {params.prok_p} >> {output[2]}
        {SRCDIR}/fastaExtract.pl {output[0]} {output[2]} >> {output[3]}
        """

rule concat_reprentatitves:
    input:
        expand("Catalogue/{sample}.prokka.faa",
                sample=samples.loc[samples.prokka_prefix == samples.prokka_prefix,"sample"])
    output:
        'Catalogue/catalogue.faa'
    params:
        runtime = "2:00:00",
        mem = MEMCORE
    threads: 1
    log: "logs/catalogue_concat_representatives.log"
    message: "concat_representatives: Concatenating all representative amino acid sequences."
    shell:
        """
        cat {input} >> {output}
        """


