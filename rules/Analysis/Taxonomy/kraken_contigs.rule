
rule kraken_contigs:
    input:
	    "Assembly/%s.assembly.merged.fa" % ASS
    output:
	    "Analysis/taxonomy/kraken/%s.kraken.contig.output" % ASS,
	    "Analysis/taxonomy/kraken/%s.kraken.contig.report" % ASS,
	    "Analysis/taxonomy/kraken/%s.kraken.fa" % ASS
    shell:
	    """
	    mkdir -p Analysis/taxonomy/kraken
	    kraken2 -db {DBPATH}/{config[krakendb]} --threads {threads} --use-names --output {output[0]} --report {output[1]} --classified-out {output[2]} {input}
	    """

rule kraken_parse:
    input:
        "Analysis/taxonomy/kraken/%s.kraken.contig.output" % ASS
    output:
        "Analysis/taxonomy/kraken/%s.kraken.parsed.tsv" % ASS
    shell:
        """
        {SRCDIR}/krakenContigEntropy_GTDB.py -d {DBPATH}/GTDB_kraken_parse_taxonomy -e 0.1 -o {output} {input}
        """


