localrules: allmotu

rule allmotu:
    input:
        expand("Analysis/taxonomy/mOTUs/{type}.mOTU.{measure}.tsv", type=TYPES, measure=['abundances','counts'])
    output:
        "mOTUs.done"
    threads: 1
    log: "logs/analysis_taxonomy_checkMotus.log"
    message: "mOTUs done?"
    shell:
        """touch {output}"""

rule motus:
    input:
        "Preprocessing/{type}.r1.preprocessed.fq",
        "Preprocessing/{type}.r2.preprocessed.fq",
	"Preprocessing/{type}.se.preprocessed.fq"
    output:
        "Analysis/taxonomy/mOTUs/{type}.mOTU.counts.tsv"
    threads: 6
    params:
        runtime = "12:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch",
        outputdir = 'Stats/{type}'
    conda: ROOT_DIR + "/envs/IMP_taxonomy.yaml"
    log: "logs/analysis_mOTUs.{type}.log"
    message: "Running mOTUs on {wildcards.type} reads."
    shell:
        """
	motus profile  -f {input[0]} -r {input[1]} -s {input[2]} -t {threads} -db {DBPATH}/db_mOTU -c -p -u -o {output[0]} >{log} 2>>{log}
        """

