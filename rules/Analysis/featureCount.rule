rule feature_count:
    input:
        "Analysis/annotation/annotation_CDS_RNA_hmms.gff",
        "Assembly/{type}.reads.sorted.bam",
        "Analysis/annotation/annotation.CDS.RNA.{db}.gff"
    output:
        "Analysis/annotation/{type}.{db}.counts.tsv"
    params:
        lambda wildcards: config["featureCountsStranding"][wildcards.type]
    threads: THREADS
    shell:
        """
	featureCounts -p -O -t CDS -g {wildcards.db} -o {output} -s {params} -a {input[0]} -T {threads} {input[1]}
	"""

rule feature_count_gene:
    input:
        "Analysis/annotation/annotation.filt.gff",
        "Assembly/{type}.reads.sorted.bam"
    output:
        "Analysis/annotation/{type}.CDS_counts.tsv",
	"Analysis/annotation/{type}.rRNA_counts.tsv"
    params:
        lambda wildcards: config["featureCountsStranding"][wildcards.type]
    threads: THREADS
    shell:
        """
        featureCounts -p -O -t CDS -g ID -o {output[0]} -s {params}  -a {input[0]} -T {threads} {input[1]}
        featureCounts -p -O -t rRNA -g ID -o {output[1]} -s {params} -a {input[0]} -T {threads} {input[1]}
        """
