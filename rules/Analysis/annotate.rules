#probably doesn't work anymore for snakemake:
rule hmmer:
    input:
        "Analysis/annotation/prokka.faa"
    output:
        "Analysis/annotation/prokka.faa.{db}.hmmscan"
    params: 
        "/work/projects/ecosystem_biology/data/hmm/{db}",
        lambda wildcards: config["hmmdbs"][wildcards.db]["cutoff"],
        runtime = "48:00:00",
        mem = MEMCORE
    conda: ROOT_DIR + "/envs/IMP_annotate.yaml"
    threads: 12
    log: "logs/analysis_hmmer.{db}.log"
    message: "Running HMMER for {wildcards.db}."
    shell:
        """
         hmmsearch --cpu {threads} {params[1]} --noali --notextw \
          --tblout {output} {params[0]}/*.hmm {input} >/dev/null
        """

rule makegff:
    input:
        "Analysis/annotation/prokka.faa.{db}.hmmscan",
        "Analysis/annotation/annotation.filt.gff",
        "Analysis/annotation/prokka.faa"
    output:
        "Analysis/annotation/annotation.CDS.RNA.{db}.gff"
    params:
        "{db}",
        lambda wildcards: config["hmmdbs"][wildcards.db]["trim"],
        runtime = "4:00:00",
        mem = MEMCORE
    threads: 1
    log: "logs/analysis_add_hmmer_results.{db}.log"
    message: "Adding hmmer results of {wildcards.db} to gff."
    shell:
        """
        {SRCDIR}/hmmscan_addBest2gff.pl -i {input[0]} -a {input[1]} \
         -n {params[0]} {params[1]} -o {output} -g $(grep ">" {input[2]} | wc -l)
        """

rule mergegff:
    input:
        expand("Analysis/annotation/annotation.CDS.RNA.{db}.gff",db=config["hmmdbs"])
    output:
        "Analysis/annotation/annotation_CDS_RNA_hmms.gff"
    params:
        runtime = "8:00:00",
        mem = MEMCORE
    threads: 1
    log: "logs/analysis_merge_hmmer_results.log"
    message: "Merging gffs with hmmer results."
    shell:
        """
        {SRCDIR}/mergegffs.pl {output} {input}
        """

