rule feature_count:
    input:
        "Assembly/{type}.reads.sorted.bam",
        "Analysis/annotation/annotation.CDS.RNA.{db}.gff"
    output:
        "Analysis/annotation/{type}.{db}.counts.tsv"
    params:
        lambda wildcards: config["featureCountsStranding"][wildcards.type],
        runtime = "8:00:00",
        mem = MEMCORE
    threads: 8
    conda: ROOT_DIR + "/envs/IMP_annotation.yaml"
    log: "logs/analysis_merge_featurecounts.{type}.{db}.log"
    message: "Quantifying {wildcards.db} with {wildcards.type} reads."
    shell:
        """
	featureCounts -p -O -t CDS -g {wildcards.db} -o {output} -s {params[0]} -a {input[1]} -T {threads} {input[0]}
	"""

rule feature_count_gene:
    input:
        "Analysis/annotation/annotation.filt.gff",
        "Assembly/{type}.reads.sorted.bam"
    output:
        "Analysis/annotation/{type}.CDS_counts.tsv",
	"Analysis/annotation/{type}.rRNA_counts.tsv"
    params:
        lambda wildcards: config["featureCountsStranding"][wildcards.type],
        runtime = "8:00:00",
        mem = MEMCORE
    threads: 8
    conda: ROOT_DIR + "/envs/IMP_annotation.yaml"
    log: "logs/analysis_merge_featurecounts.{type}.genes.log"
    message: "Quantifying ORFs and rRNAs with {wildcards.type} reads."
    shell:
        """
        featureCounts -p -O -t CDS -g ID -o {output[0]} -s {params[0]}  -a {input[0]} -T {threads} {input[1]}
        featureCounts -p -O -t rRNA -g ID -o {output[1]} -s {params[0]} -a {input[0]} -T {threads} {input[1]}
        """
