rule variant_calling:
    input:
        "Assembly/%s.assembly.merged.fa" % ASS,
        "Assembly/{type}.reads.sorted.bam"
    output:
        "Analysis/snps/{type}.variants.samtools.vcf.gz",
    params:
        runtime = "48:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch"
    conda: ROOT_DIR + "/envs/IMP_mapping.yaml"
    threads: 1
    log: "logs/analysis_variants.{type}.log"
    message: "Calling variants using bcftools for {wildcards.type} reads."
    shell:
        """
        #temporary directory and files
        VCF_MPU=$(mktemp --tmpdir={TMPDIR} -t "XXXXXX.mpu.vcf")
        VCF_PLT=$(mktemp --tmpdir={TMPDIR} -t "XXXXXX.plt.vcf")
        echo "$VCF_MPU"
        echo "$VCF_PLT"

        ### run_mpileup {input[0]} {input[1]} {output[0]}
        echo "Running samtools mpileup"
        bcftools mpileup -A -Ou -f {input[0]} {input[1]} |
        bcftools call -vmO >$VCF_MPU 
        bgzip -c $VCF_MPU > {output[0]}
        tabix -f -p vcf {output[0]}
        """
