def workflow_ctrl:
    return([s + ".done" for s in IMP_STEPS])

# data input
# inputs (original files) to use
def get_ori_files:
    inputs = []
    if MG:
        inputs.append(MG)
    if MT:
        inputs.append(MT)
    if CONTIGS and not "assembly" in IMP_STEPS:
        inputs.append(CONTIGS)
        if MGaln:
            inputs.append(MGaln)
        if MTaln:
            inputs.append(MTaln)
    if "assembly" in IMP_STEPS and LONG:
        inputs.append(LONG)
    return(inputs)

# outputs (input for workflow) to be generated (in rule)
def list_input_files:
    outputs = []
    if MG and len(MG) == 2:
        outputs.append("Preprocessing/mg.r1.fq")
        outputs.append("Preprocessing/mg.r2.fq")
    elif MG and len(MG) == 3:
        outputs.append("Preprocessing/mg.r1.fq")
        outputs.append("Preprocessing/mg.r2.fq")
        outputs.append("Preprocessing/mg.se.fq")
    if MT and len(MT) == 2:
        outputs.append("Preprocessing/mt.r1.fq")
        outputs.append("Preprocessing/mt.r2.fq")
    elif MT and len(MT) == 3:
        outputs.append("Preprocessing/mt.r1.fq")
        outputs.append("Preprocessing/mt.r2.fq")
        outputs.append("Preprocessing/mt.se.fq")
    if CONTIGS and not "assembly" in IMP_STEPS:
            outputs.append("Assembly/%s.assembly.merged.fa" %ASS)
            if MGaln:
                outputs.append("Assembly/mg.reads.sorted.bam")
            if MTaln:
                inputs.append(MTaln)
                outputs.append("Assembly/mt.reads.sorted.bam")
    if "assembly" in IMP_STEPS and LONG:
        outputs.append("Assembly/long_reads.fastq")
    return(outputs)

# symlinks to be generated (from , to)
def list_symlinks:
    symlinks = []
    if not 'preprocessing' in IMP_STEPS and MG:
        symlinks.append(("mg.r1.fq", "Preprocessing/mg.r1.preprocessed.fq"))
        symlinks.append(("mg.r2.fq", "Preprocessing/mg.r2.preprocessed.fq"))
        symlinks.append(("mg.se.fq", "Preprocessing/mg.se.preprocessed.fq"))
    if not 'preprocessing' in IMP_STEPS and MT:
        symlinks.append(("mt.r1.fq", "Preprocessing/mt.r1.preprocessed.fq"))
        symlinks.append(("mt.r2.fq", "Preprocessing/mt.r2.preprocessed.fq"))
        symlinks.append(("mt.se.fq", "Preprocessing/mt.se.preprocessed.fq"))
    return(symlinks)

