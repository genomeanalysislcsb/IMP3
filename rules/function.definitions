# empty se files to be touched
def list_fake_input:
    fake_output = []
    if not 'preprocessing' in IMP_STEPS and MG and len(MG) == 2:
        fake_output.append("Preprocessing/mg.se.fq")
    if not 'preprocessing' in IMP_STEPS and MT and len(MT) == 2:
