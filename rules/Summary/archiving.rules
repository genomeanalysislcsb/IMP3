rule sync_final:
    input:
        OUTPUTDIR
    output:
        SUMDIR
    threads: 1
    params:
        runtime = "24:00:00",
        mem = MEMCORE
    message: "Synching {OUTPUTDIR} to {SUMDIR}"
    shell:
        """
        rsync -a --remove-source-files {OUTPUTDIR} {SUMDIR}
        """

rule gzip:
    input:
        check="workflow.done",
        file="{file}"
    output:
        "{file}.gz"
    threads: 1  
    params:
        runtime = "24:00:00",
        mem = MEMCORE
    message: "gzip: gzipping {wildcards.file}."
    shell:
        "gzip {input.file}"

rule tar_gzip_directory:
    input:
        check="workflow.done",
        directory="{directory}"
    output:
        "{directory}.tar.gz"
    threads: 1
    params:
        runtime = "24:00:00",
        mem = MEMCORE
    message: "tar_gzip: tarring and gzipping {wildcards.directory}."
    shell:
        "tar -cvzf {output} {input.directory} && rm -R {input.directory}"



