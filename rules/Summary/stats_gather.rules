sum_stats_input = ["workflow.done"]
if not "preprocessing" in IMP_STEPS:
    sum_stats_input.append("preprocessing.analysed")
if CONTIGS:
    sum_stats_input.append("assembly.analysed")

localrules: ALL_stats 

rule gather_stats:
    input:
        sum_stats_input
    output:
        "Stats/all_stats.tsv",
        "Stats/all_stats.Rdata",
        "Stats/all_bin_stats.tsv" # only if binning done
    params:
        runtime = "12:00:00",
        mem = MEMCORE,
        steps = IMP_STEPS,
        ass = ASS,
        types = TYPES,
        dbs = config["hmm_DBs"]
    log: "logs/stats_gather_stats.log"
    message: "gather_stats: Summarizing stats."
    threads: 1
    conda: ENVDIR + "/IMP_binning.yaml"
    script:
        SRCDIR + "/summarize_all_stats.R"
         
rule ALL_stats:
    input:
        "Stats/all_stats.tsv",
        "Stats/all_stats.Rdata"
    output:
        touch("stats.done")


