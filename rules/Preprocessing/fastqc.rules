rule fastqc_raw:
    input:
        'Preprocessing/{type}.r1.fq',
        'Preprocessing/{type}.r2.fq'
    output:
        'Stats/{type}/{type}.r1_fastqc.html',
        'Stats/{type}/{type}.r2_fastqc.html',
        'Stats/{type}/{type}.r1_fastqc.zip',
        'Stats/{type}/{type}.r2_fastqc.zip',
    threads: 2
    params:
        runtime = "1:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch",
        outputdir = 'Stats/{type}'
    conda: ROOT_DIR + "/envs/IMP_preprocessing.yaml"
    log: "logs/preprocessing_fastqc_raw.{type}.log"
    message: "Running fastQC on raw {wildcards.type} reads."
    shell:
        """
        mkdir -p {params.outputdir}
        fastqc -o {params.outputdir} -f fastq {input[0]} {input[1]} -t {threads} -d {TMPDIR}
        """

rule fastqc_preprocessed:
    input:
        'Preprocessing/{type}.r1.preprocessed.fq',
        'Preprocessing/{type}.r2.preprocessed.fq',
        'Preprocessing/{type}.se.preprocessed.fq',
        'Stats/{type}/{type}.r1.fq_fastqc.html'
    output:
        'Stats/{type}/{type}.r1.preprocessed_fastqc.html',
        'Stats/{type}/{type}.r2.preprocessed_fastqc.html',
        'Stats/{type}/{type}.se.preprocessed_fastqc.html',
        'Stats/{type}/{type}.r1.preprocessed_fastqc.zip',
        'Stats/{type}/{type}.r2.preprocessed_fastqc.zip',
        'Stats/{type}/{type}.se.preprocessed_fastqc.zip'
    threads: 3
    params:
        runtime = "1:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch",
        outputdir = 'Stats/{type}'
    log: "logs/preprocessing_fastqc_preprocessed.{type}.log"
    message: "Running fastqc on preprocessed {wildcards.type} reads."
    conda: ROOT_DIR + "/envs/IMP_preprocessing.yaml"
    shell:
        """
        if [[ -s {input[2]} ]]
        then
          fastqc -o {params.outputdir} -f fastq {input[0]} {input[1]} {input[2]} -t {threads} -d {TMPDIR}
        else
          echo "{input[2]} is empty, FastQC will not run for that file"
          fastqc -o {input[3]} -f fastq {input[0]} {input[1]} -t {threads} -d {TMPDIR}
          echo "Creating empty files for {input[2]}..."
          touch {output[2]}
        echo "No single end reads were generated" > {output[5]}
        fi
        """
