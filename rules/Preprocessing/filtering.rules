FILTERING_CMD = """
        TMP_FILE=$(mktemp --tmpdir={TMPDIR} -t "alignment_XXXXXX.bam")
        bwa mem -v 1 -t {threads} {input[3]} {input[0]} {input[1]} | samtools view --threads {threads} -bS - > $TMP_FILE
        samtools merge --threads {threads} -u - \
         <(samtools view --threads {threads} -u  -f 4 -F 264 $TMP_FILE) \
         <(samtools view --threads {threads} -u -f 8 -F 260 $TMP_FILE) \
         <(samtools view --threads {threads} -u -f 12 -F 256 $TMP_FILE) | \
        samtools view --threads {threads} -bF 0x800 -  | samtools sort --threads {threads} -m {BIGMEMCORE} -n -  | \
        bamToFastq -i stdin -fq {output[0]} -fq2 {output[1]}
        if [[ -s {input[2]} ]]
         then
         bwa mem -v 1 -t {threads} {input[3]} {input[2]} | samtools view --threads {threads} -bS - | \
         samtools view --threads {threads} -uf 4 - | bamToFastq -i stdin -fq {output[2]}
        else
         echo "{input[2]} is empty, skipping single end human sequence filtering, but creating it anyway..."
         touch {output[2]}
        fi
        rm -rf $TMP_FILE
        """

SYMLINK_CMD = """
ln -fs $(echo {input[0]} | cut -f 2 -d /) {output[0]} && touch -h {output[0]}
ln -fs $(echo {input[1]} | cut -f 2 -d /) {output[1]} && touch -h {output[1]}
ln -fs $(echo {input[2]} | cut -f 2 -d /) {output[2]} && touch -h {output[2]}
"""


rule mg_filtering:
    input:
        'Preprocessing/mg.r1.trimmed.fq',
        'Preprocessing/mg.r2.trimmed.fq',
        'Preprocessing/mg.se.trimmed.fq',
        '{dir}/{ref}.fa'.format(dir=DBPATH + "/filtering", ref=FILTER),
        expand(
            "{p}/filtering/{filter}.{ext}", filter=FILTER,
            ext=['fa', 'fa.amb', 'fa.ann', 'fa.bwt', 'fa.pac', 'fa.sa'], p=DBPATH)
    output:
        'Preprocessing/mg.r1.trimmed.%s_filtered.fq' % FILTER,
        'Preprocessing/mg.r2.trimmed.%s_filtered.fq' % FILTER,
        'Preprocessing/mg.se.trimmed.%s_filtered.fq' % FILTER
    params:
        runtime = "24:00:00",
        partition = "-p bigmem --qos qos-bigmem -N 1",
        mem = "--mem=" + BIGMEMTOTAL + "G"
    threads: BIGCORENO
    conda: "envs/IMP_mapping.yaml"
    log: "logs/preprocessing_mgFiltering.log"
    message: "Filtering mg reads against {filter}."
    shell:
        FILTERING_CMD

rule mt_filtering:
    input:
        'Preprocessing/mt.r1.trimmed.rna_filtered.fq',
        'Preprocessing/mt.r2.trimmed.rna_filtered.fq',
        'Preprocessing/mt.se.trimmed.rna_filtered.fq',
        '{dir}/{ref}.fa'.format(dir=DBPATH + "/filtering", ref=FILTER),
        expand(
            "{p}/filtering/{filter}.{ext}", filter=FILTER,
            ext=['fa', 'fa.amb', 'fa.ann', 'fa.bwt', 'fa.pac', 'fa.sa'], p=DBPATH)
    output:
        'Preprocessing/mt.r1.trimmed.rna_filtered.%s_filtered.fq' % FILTER,
        'Preprocessing/mt.r2.trimmed.rna_filtered.%s_filtered.fq'% FILTER ,
        'Preprocessing/mt.se.trimmed.rna_filtered.%s_filtered.fq' % FILTER
    params:
        runtime = "24:00:00",
        partition = "-p bigmem --qos qos-bigmem -N 1",
        mem = "--mem=" + BIGMEMTOTAL + "G"
    threads: BIGCORENO
    conda: "envs/IMP_mapping.yaml"
    log: "logs/preprocessing_mtFiltering.log"
    message: "Filtering mt reads against {filter}."
    shell:
        FILTERING_CMD


rule symlink_mt_preprocessed_files:
    input:
        'Preprocessing/mt.r1.trimmed.rna_filtered.%s_filtered.fq' % FILTER,
        'Preprocessing/mt.r2.trimmed.rna_filtered.%s_filtered.fq' % FILTER,
        'Preprocessing/mt.se.trimmed.rna_filtered.%s_filtered.fq' % FILTER
    output:
        'Preprocessing/mt.r1.preprocessed.fq',
        'Preprocessing/mt.r2.preprocessed.fq',
        'Preprocessing/mt.se.preprocessed.fq'
    params:
        runtime = "1:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch" 
    threads: 1
    log: "logs/preprocessing_mtFilterSymlink.log"
    message: "Symlinking filtered mt reads."
    shell:
        SYMLINK_CMD

rule symlink_mg_preprocessed_files:
    input:
        'Preprocessing/mg.r1.trimmed.%s_filtered.fq' % FILTER,
        'Preprocessing/mg.r2.trimmed.%s_filtered.fq' % FILTER,
        'Preprocessing/mg.se.trimmed.%s_filtered.fq' % FILTER
    output:
        'Preprocessing/mg.r1.preprocessed.fq',
        'Preprocessing/mg.r2.preprocessed.fq',
        'Preprocessing/mg.se.preprocessed.fq'
    params:
        runtime = "1:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch"
    threads: 1
    log: "logs/preprocessing_mgFilterSymlink.log"
    message: "Symlinking filtered mg reads."
    shell:
        SYMLINK_CMD
