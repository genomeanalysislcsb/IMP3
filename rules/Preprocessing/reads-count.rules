checkpoint reads_count:
    input:
        reads_input_files
    output:
        'Stats/{type}/{type}.read_counts.txt'
    params:
        runtime = "8:00:00",
        mem = MEMCORE
    threads: 1
#    log: "logs/analysis_read_numbers.{type}.log"
    message: "reads_count: Getting length of {wildcards.type} fastq files."
    run:
        for fs in {input}:
            for f in fs:
                shell('echo -e "{f}\t$(($(wc -l < {f})/4))" >> {output}')

rule reads_gzip:
    input:
        gather_reads
    output:
        "Preprocessing/{type}.reads.compressed"
    params:
        runtime = "8:00:00",
        mem = MEMCORE
    threads: 1
    message: "reads_gzip: Gzipping fastq files."
    shell:
        """
        gzip -q {input} 
        """