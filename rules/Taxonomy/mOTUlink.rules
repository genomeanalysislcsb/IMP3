rule allmotulinks:
    input:
        expand("Analysis/taxonomy/mOTU_links/{COG}.bestPresentHitPhylogeny.tsv",COG=config["COGS"])
    output:
        "Analysis/taxonomy/mOTU_links/bestPresentHitPhylogeny.tsv"
    threads: 1
    params:
        runtime = "2:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch"
    log: "logs/analysis_mOTU_bestPresentHitPhylogeny.log"
    message: "Extracting phylogeny for best mOTU hits."
    shell:
        """
        cat <(head -n 1 {input} | tail -n 1) <(cat {input} | grep -v queryID ) > {output}
        """

rule fetchmg:
    input:
        "Analysis/annotation/prokka.ffn",
        "Analysis/annotation/prokka.faa",
        "Analysis/taxonomy/mOTU_links"
    output:
        directory("Analysis/taxonomy/mOTU_links/marker_genes"),
        expand("Analysis/taxonomy/mOTU_links/marker_genes/{COG}.fna",COG=config["COGS"])
    threads: 6
    params:
        runtime = "12:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch"
    log: "logs/analysis_mOTU_extractMarkerGenes.log"
    message: "Finding mOTU marker genes in open reading frames."
    shell:
        """
        {BINDIR}/fetchMG/fetchMG.pl -o {output[0]} -t {threads} -d {input[0]}  -m extraction {input[1]}
        """
	
rule get_present_mOTUs:
    input:
        expand("Analysis/taxonomy/mOTUs/{type}.mOTU.counts.tsv",type=TYPES)
    output:
        directory("Analysis/taxonomy/mOTU_links"),		
        "Analysis/taxonomy/mOTU_links/all.mOTUs.present"
    threads: 1
    params:
        runtime = "2:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch"
    log: "logs/analysis_mOTU_getPresent.log"
    message: "Extracting identity of present mOTUs."
    shell:
        """
        grep "motus.processing" -v {input} -h | cut -f 1 | sort | uniq > {output[1]}
	"""

#I don't think this can work - AHB:
rule extract_mOTU_db_genes:
    input:
        "Analysis/taxonomy/mOTU_links/all.mOTUs.present"
    output:
        "Analysis/taxonomy/mOTU_links/{COG}.present.mOTU.DBgenenames.txt",
        "Analysis/taxonomy/mOTU_links/{COG}.present.DBgenes.fna"
    threads: 1
    params:
        runtime = "12:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch"
    conda: ROOT_DIR + "/envs/IMP_taxonomy.yaml"
    log: "logs/analysis_getting_presentCOGgenes.log"
    message: "Extracting gene names for present mOTUs."
    shell:
        """
        Rscript {SRCDIR}/mergeMOTUgeneInfo.R {wildcards.COG} {input} {output[0]}
        {SRCDIR}/fastaExtract.pl $imp_lib/motus_linking/{wildcards.COG}/{wildcards.COG}.mOTU.v1.padded {output[0]} > {output[1]}
        """

rule blast_mOTU_db_genes:
    input:
        "Analysis/taxonomy/mOTU_links/{COG}.present.DBgenes.fna",
        "Analysis/taxonomy/mOTU_links/marker_genes/{COG}.fna"
    output:
        "Analysis/taxonomy/mOTU_links/{COG}.bestPresentHits.tsv",
        "Analysis/taxonomy/mOTU_links/{COG}.bestPresentHitPhylogeny.tsv"
    threads: 1
    params:
        runtime = "12:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch"
    conda: ROOT_DIR + "/envs/IMP_taxonomy.yaml"
    log: "logs/analysis_blast.log"
    message: "Blasting {wildcars.COG} genes to present mOTUs."
    shell:
        """
        makeblastdb -in {input[0]} -dbtype nucl -parse_seqids
        blastn -db {input[0]} -query {input[1]} -outfmt 7 -out {output[0]} -max_target_seqs 1
        Rscript {SRCDIR}/mergeMOTUblast.R {wildcards.COG} {output[0]} {output[1]}
        """


