rule maxbin:
    input:
       "Assembly/%s.assembly.merged.fa" % ASS,
       "Analysis/mg.assembly.contig_depth.0.txt"
    output:
       "Binning/MaxBin/maxbin_res.log",
       "Binning/MaxBin/maxbin_res.summary"
    threads: 4
    params:
        runtime = "24:00:00",
        partition = "-p bigmem --qos qos-bigmem ",
        mem = "--mem-per-cpu " + BIGMEMCORE
    conda: ROOT_DIR + "/envs/IMP_binning.yaml"
    log: "logs/binning_MaxBin.log"
    message: "Running MaxBin."
    shell:
        """
	## Create MaxBin dir
        mkdir -p Binning/MaxBin

	## Run MaxBin
        run_MaxBin.pl -contig {input[0]} \
        -abund {input[1]} \
        -out Binning/MaxBin/maxbin_res \
        -thread {threads} \
        -min_contig_length {config[binning][MaxBin][cutoff]}
        """
