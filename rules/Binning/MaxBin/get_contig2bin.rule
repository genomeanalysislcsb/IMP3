rule maxbin_contig2bin:
    input:
        "Binning/MaxBin/maxbin_res.log"
    output:
        "Binning/MaxBin/maxbin_contig2bin.txt",
        "Binning/MaxBin/scaffold2bin.tsv"
    shell:
        """
        echo "Getting contig to bin mapping"
        for f in $(ls Binning/MaxBin/*.fasta | cut -f3 -d "/"); do sed -e "s/$/\t$f/g" <(grep "^>" Binning/MaxBin/$f | sed -e 's/>//g') >> {output[0]}; done
        ln -s ../../{output[0]} {output[1]}
        echo "Contig to bin mapping done"
        """
