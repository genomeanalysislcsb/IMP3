rule getBins:
    input: 
        "Binning/selected_DASTool_summary.txt"
    output:
        dynamic({clusterID}

rule grid:
    input:
        "Binning/GRiD.prepped",
        "Binning/selected_DASTool_summary.txt"
    output:
        "Binning/GRiD.done"
    shell:
        """
        for cluster in `grep "^bin" -v {input[1]} | cut -f 1`
        do
	    echo "# GRiD $cluster" 
            grid single -r Binning/selected_DASTool_bins/$cluster -o Binning/selected_DASTool_bins/$cluster/grid -g Binning/selected_DASTool_bins/$cluster/contigs.fa
	    echo "# GRiD $cluster done"
	done
        touch {output}
        """

rule prepare_grid:
    input:
        "Binning/selected_DASTool_summary.txt",
        "Assembly/mg.reads.sorted.bam"
    output:
        "Binning/GRiD.prepped"
    shell:
        """
        for cluster in `grep "^bin" -v {input[0]} | cut -f 1`
        do
            echo " $cluster prepping start"
	    mkdir -p Binning/selected_DASTool_bins/$cluster
            cp Binning/selected_DASTool_bins/$cluster.contigs.fa Binning/selected_DASTool_bins/$cluster/contigs.fa
            {SRCDIR}/fastaBed.pl Binning/selected_DASTool_bins/$cluster/contigs.fa >> Binning/selected_DASTool_bins/$cluster/contigs.bed
            samtools view -b -F 5 -L Binning/selected_DASTool_bins/$cluster/contigs.bed {input[1]}  | samtools bam2fq -n - > Binning/selected_DASTool_bins/$cluster/reads.fastq
            samtools view -b -f 65 -F 4 -L Binning/selected_DASTool_bins/$cluster/contigs.bed {input[1]}  | samtools bam2fq -n - >> Binning/selected_DASTool_bins/$cluster/reads.fastq
            samtools view -b -f 129 -F 4 -L Binning/selected_DASTool_bins/$cluster/contigs.bed {input[1]}  | samtools bam2fq -n - >> Binning/selected_DASTool_bins/$cluster/reads.fastq
	    echo "# $cluster prepping done"
        done
        touch {output}
        """
