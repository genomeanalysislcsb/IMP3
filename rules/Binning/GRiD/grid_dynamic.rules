import pandas as pd

def gather_bins(wildcards):
    checkpoint_output = checkpoints.getBins.get(**wildcards).output[0]
    return expand("Binning/selected_DASTool_bins/{i}/grid",
           i=glob_wildcards("Binning/selected_DASTool_bins/{i}/contigs.fa").i)

localrules: grid_all

rule grid_all:
    input: 
        gather_bins
    output:
        "Binning/GRiD.done"
    shell:
        """
        touch {output}
        """

checkpoint getBins:
    input: 
        "Binning/selected_DASTool_summary.txt"
    output:
        "Binning/GRiD.prepped"
    params:
        runtime = "8:00:00",
        mem = MEMCORE
    threads: 1
    log: "logs/binning_prepareGRiD.log"
    message: "Copying DAStool bins to single directories."
    run:
        selected_bins=pd.read_table(input)['bin']
        for BIN in selected_bins:
            shell("cp Binning/selected_DASTool_bins/{BIN}.contigs.fa Binning/selected_DASTool_bins/{BIN}/contigs.fa")
    
rule grid:
    input:
       "Binning/selected_DASTool_bins/{clusterID}/contigs.fa",
       "Binning/selected_DASTool_bins/{clusterID}/reads.fastq"
    output:
        directory("Binning/selected_DASTool_bins/{clusterID}/grid")
    params:
        clusterInput="Binning/selected_DASTool_bins/{wildcards.clusterID}",
        runtime = "24:00:00",
        mem = BIGMEMCORE
    threads: 1
    conda: ROOT_DIR + "/envs/IMP_bining.yaml"
    log: "logs/binning_GRiD.{clusterID}.log"
    message: "Running GRiD on {wildcards.clusterID}."
    shell:
        """
        grid single -r {params.clusterInput} -o {output} -g {input[0]}
        """

rule prepare_gridBed:
    input:
        "Binning/selected_DASTool_bins/{clusterID}/contigs.fa"
    output:
        "Binning/selected_DASTool_bins/{clusterID}/contigs.bed"
    params:
        runtime = "2:00:00",
        mem = MEMCORE
    threads: 1
    log: "logs/binning_prepareGRiDbed.{clusterID}.log"
    message: "Preparing .bed file for GRiD - {wildcards.clusterID}."
    shell:
        """
        {SRCDIR}/fastaBed.pl {input} >> {output}
        """

rule prepare_gridReads:
    input:
        "Assembly/mg.reads.sorted.bam",
        "Binning/selected_DASTool_bins/{clusterID}/contigs.bed"
    output:
        "Binning/selected_DASTool_bins/{clusterID}/reads.fastq"
    params:
        runtime = "12:00:00",
        mem = BIGMEMCORE
    threads: 1
    log: "logs/binning_prepareGRiDfastq.{clusterID}.log"
    message: "Preparing fastq file for GRiD - {wildcards.clusterID}."
    conda: ROOT_DIR + "/envs/IMP_mapping.yaml"
    shell:
        """
        samtools view -b -F 5 -L {output[1]} {input[0]} | samtools bam2fq -n - > {output} 
        samtools view -b -f 65 -F 4 -L {output[1]} {input[0]}  | samtools bam2fq -n - >> {output}
        samtools view -b -f 129 -F 4 -L {output[1]} {input[0]}  | samtools bam2fq -n - >> {output}
        """
