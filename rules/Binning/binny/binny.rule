PLOT_OUTPUT_FILES = [
    "Stats/mg/mg.read_stats.html",
    "Stats/mg/mg.read_stats.txt",
    "Stats/mg/mg_mapping_stats.html",
    "Stats/mg/mg_mapping_stats.txt",
    "Stats/mt/mt.read_stats.html",
    "Stats/mt/mt.read_stats.txt",
    "Stats/mt/mt_mapping_stats.html",
    "Stats/mt/mt_mapping_stats.txt",
    "Stats/mgmt/mgmt_results.Rdat",
    expand("Binning/binny/reachabilityDistanceEstimates.{pk}.{nn}.tsv \
    Binning/binny/clusterFirstScan.{pk}.{nn}.tsv \
    Binning/binny/bimodalClusterCutoffs.{pk}.{nn}.tsv \
    Binning/binny/contigs2clusters.{pk}.{nn}.tsv \
    Binning/binny/contigs2clusters.{pk}.{nn}.RDS \
    Binning/binny/clusteringWS.{pk}.{nn}.Rdata \
    Binning/binny/finalClusterMap.{pk}.{nn}.pdf".split(),pk=config["binning"]["binny"]["pk"],nn=config["binning"]["binny"]["nn"])
]

rule binny_visualize:
    input:
       'Stats/mg/mg.read_counts.txt',
       'Stats/mt/mt.read_counts.txt',
       'Stats/mg/mg.assembly.contig_flagstat.txt',
       'Stats/mt/mt.assembly.contig_flagstat.txt',
       'Stats/mg/mg.assembly.contig_coverage.txt',
       'Stats/mt/mt.assembly.contig_coverage.txt',
       'Stats/mg/mg.assembly.contig_depth.txt',
       'Stats/mt/mt.assembly.contig_depth.txt',
       'Stats/mgmt/mgmt.assembly.gc_content.txt',
       "Binning/binny/%s.vizbin.with-contig-names.points" % ASS,
       "Analysis/annotation/annotation_CDS_RNA_hmms.gff"
    output:
        PLOT_OUTPUT_FILES
    threads: 1
    params:
        runtime = "24:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch"
    conda: ROOT_DIR + "/envs/IMP_binning.yaml"
    log: "logs/binning_binny.log"
    message: "Running binny."
    shell:
        """
        PLOT_SCRIPT="{SRCDIR}/IMP_visualize_mgmt_commented.R"
        mkdir -p Analysis/results
        mkdir -p Binning/binny/clusterFiles
	Rscript $PLOT_SCRIPT {config[imp_lib]} Analysis/results {input} {SRCDIR}/IMP_plot_binny_functions.R {config[binning][binny][pk]} {config[binning][binny][nn]}
        """
