rule cut_rRNA:
    input:
        "Assembly/{ASS}.assembly.merged.fa",
        "Analysis/annotation/annotation.filt.gff"
    output:
        "Binning/binny/{ASS}.assembly.merged.cut.fa"
    log: "logs/binning_rRNAcutting.{ASS}.log"
    params:
        runtime = "12:00:00",
        mem = MEMCORE
    threads: 1
    message: "Cutting contigs for vizbin."
    shell:
        """
        {SRCDIR}/fastaExtractCutRibosomal1000.pl -f {input[0]} -g {input[1]} -l {log} -o {output} -c {config[vizbin][cutoff]}
        """

rule vizbin:
    input:
        "Binning/binny/{ass}.assembly.merged.cut.fa"
    output:
        "Binning/binny/{ass}.vizbin.with-contig-names.points"
    params:
        runtime = "24:00:00",
        mem = BIGMEMCORE
    threads: 1
    log: "logs/binning_vizbin.{ass}.log"
    message: "Running VizBin."
    shell:
        """
        TMP_VIZBIN=$(mktemp --tmpdir=Analysis -dt "VIZBIN_XXXXXX")
        java -jar {SRCDIR}/VizBin-dist.jar \
         -a {config[vizbin][dimension]} \
         -c {config[vizbin][cutoff]} \
         -i {input} \
         -o $TMP_VIZBIN/data.points \
         -k {config[vizbin][kmer]} \
         -p {config[vizbin][perp]}

         if [ -f $TMP_VIZBIN/data.points ]
           then
             paste <(grep "^>" {input} | sed -e 's/>//') \
              <(cat $TMP_VIZBIN/data.points | sed -e 's/,/\t/') > {output}
           fi
        rm -rf $TMP_VIZBIN
        """
