rule binny_separate_bins:
    input:
        expand("Binning/binny/contigs2clusters.{pk}.{nn}.tsv",pk=config["binning"]["binny"]["pk"],nn=config["binning"]["binny"]["nn"]),
	"Binning/binny",
        "Assembly/%s.assembly.merged.block.fa" % ASS,
        "Analysis/annotation/annotation.filt.gff",
        "Analysis/annotation/{p}.faa".format(p=config['prokka']['prefix'])
    output:
        "Binning/binny/genome_locations.tsv",
	"Binning/binny/separate_bins.done"
    shell:
        """
	for qual in P G O L C
	    do
	    for cluster in `cut -f 2 {input[0]} | grep $qual | sort | uniq`
		do
		mkdir {input[1]}/$cluster
		grep $cluster -w -F {input[0]} | cut -f 1 >> {input[1]}/$cluster/contigs.names
		join -1 1 -2 1 -t $'\t' <(sort -k 1 input{3}) <(sort {input[1]}/$cluster/contigs.names) >> {input[1]}/$cluster/annotation.gff
                grep CDS -w {input[1]}/$cluster/annotation.gff | cut -f 9 | \
                sed 's#.*ID=\([^;]*\);.*#\1#' >> {input[1]}/$cluster/proteins.names
		fastaExtract.pl {input[2]} {input[1]}/$cluster/contigs.names >> $cluster/contigs.fna
		fastaExtract.pl {input[3]} {input[1]}/$cluster/contigs.names >> $cluster/proteins.faa
		printf "%s\t%s\n" "$cluster/contigs.fna" "$cluster" >> {output[0]}
		done
        done
        echo "Complete separating bins"
        touch {output[1]}
        """
