rule GTDBtk_bins_single:
    input:
        "Binning/selected_genome_locations.tsv"
    output:
        "Binning/selected_GTDBtk.done",
        "Binning/selected_GTDBtk_classifications"
    threads: THREADS
    shell:
        """
	conda activate gtdbtk
        mkdir -p  {output[1]}
        for genome in `cut -f 2 {input}`
          do
	  echo "# $gemoe gtdbtk start"
          gdirp=`grep $genome -w {input} | cut -f 1`
          gdir=${{gdirp/contigs.fa/}}
          gtdbtk classify_wf --genome_dir $gdir -x fa --out_dir ${{gdir}}GTDB --cpus {threads}
          if [ -f ${{gdir}}GTDB/gtdbtk.bac120.summary.tsv ] 
          then
            tail -n 1 ${{gdir}}GTDB/gtdbtk.bac120.summary.tsv | sed "s/contigs/$genome/" >> {output[1]}/gtdbtk.bac120.summary.tsv
          fi
          if [ -f ${{gdir}}GTDB/gtdbtk.ar122.summary.tsv ] 
          then
            tail -n 1 ${{gdir}}GTDB/gtdbtk.ar122.summary.tsv | sed "s/contigs/$genome/" >> {output[1]}/gtdbtk.ar122.summary.tsv
          fi
	  echo "# $gemoe gtdbtk done"
        done 
        touch {output[0]}
	conda deactivate 
        """




rule prepare_genomes_dastool:
    input:
        "Binning/selected_DASTool_bins",
        "Binning/GRiD.prepped"
    output:
        "Binning/selected_genome_locations.tsv"
    shell:
        """
        for cf in `ls {input[0]} | grep -v contigs.fa`
        do
            printf "%s\t%s\n" "Binning/selected_DASTool_bins/$cf/contigs.fa" "$cf" 
        done >{output[0]} 
        """


