rule metabat:
    input:
        "Assembly/%s.assembly.merged.fa" % ASS,
        "Analysis/mg.assembly.contig_depth.txt"
    output:
        "Binning/MetaBAT/metabat_res",
	"Binning/MetaBAT/scaffold2bin.tsv"
    threads: THREADS
    shell:
        """
        ## Create MetaBat dir
        mkdir -p Binning/MetaBAT
	TMP_FILE=$(mktemp --tmpdir=Analysis -t "metabat_depth_XXXXXX.tsv")       
 	echo "# fakeheader" > $TMP_FILE
	cat {input[1]}  >> $TMP_FILE
        ## Run MetaBat
        metabat2 -i {input[0]} \
        -a $TMP_FILE --cvExt \
	--saveCls \
        -o {output[0]} \
        -t {threads} \
        -m {config[binning][MetaBAT][cutoff]}
	ln -s ../../{output[0]} {output[1]}
	rm $TMP_FILE
        """
