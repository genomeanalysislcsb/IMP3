if "assembly" in IMP_STEPS and LONG:
    inputs.append(LONG)
    outputs.append("Assembly/long_reads.fastq")

#CHUNK_SIZE = 1024

localrules: prepare_input_data

rule prepare_input_data:
    input:
        inputs
    output:
        outputs,
        fake_output,     
        symlinked_output
    threads: 1
    params:
        runtime = "4:00:00",
        mem = "--mem-per-cpu " + MEMCORE,
        partition = "-p batch --qos qos-batch"
    message: "Preparing input."
    run:
        prepare_input_files(input, outputs)
        if fake_output:
            touch_fake_output(fake_output)
        if symlinks:
            symlink_input_files(symlinks)


