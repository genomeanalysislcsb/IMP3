# include global functions
include:
    "rules/function.definitions"

# include configuration file
include:
    "rules/ini/multi_config"

# set working directory and dump output
workdir:
    OUTPUTDIR

yaml.add_representer(OrderedDict, lambda dumper, data: dumper.represent_mapping('tag:yaml.org,2002:map', data.items()))
yaml.add_representer(tuple, lambda dumper, data: dumper.represent_sequence('tag:yaml.org,2002:seq', data))
yaml.dump(config, open_output('multi.config.yaml'), allow_unicode=True,default_flow_style=False)

# include rules for the workflow based on the input parameters
include:
    "rules/multi.input.rules"

# include workflows for data collection, catalogue, dRep and DB
if 'collate' in MULTI_STEPS:
    include:
        "workflows/multi/Collate"
if 'catalogue' in MULTI_STEPS:
    include:
        "workflows/multi/Catalogue"
if 'dereplicate' in MULTI_STEPS:
    include:
        "workflows/multi/Dereplicate"
if 'DB' in MULTI_STEPS:
    include:
        "workflows/multi/DB"
if 'visualize' in MULTI_STEPS:
    include:
        "workflows/multi/Vis"
else:
    raise Exception('No input data.')


# master command
rule ALL:
    input:
        expand("{step}.done",step=MULTI_STEPS),
        "sample_table.tsv"
    output:
        touch('multi.done')


rule SamplesPrint:
    input:
        config['sample_table']
    output:
        "sample_table.tsv"
    threads: 1
    params:
        runtime="00:10:00",
        mem="8G"
    run:
        samples.to_csv(path_or_buf=output[0],sep="\t",index=False,index_label=False)
