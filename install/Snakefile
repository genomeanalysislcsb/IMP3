##################################################
# MODULES

import os
import re
import pandas
from snakemake.utils import validate

# utils
include:
    "rules/common.smk"

##################################################
# CONFIG

# Config validation
validate(config, srcdir("../schemas/schema.install.yaml"))
print(f"CONFIG:\n{config}")

# paths
ENV_DIR = srcdir("envs")
SRC_DIR = srcdir("scripts")

# default executable for snakemake
shell.executable("bash")

# working directory
workdir:
    config["db_path"]

##################################################
# TARGETS

TARGETS = []

# adapters, Trimmomatic
if "trimmomatic" in config:
    print("ADD: trimmomatic")
    include:
        "rules/trimmomatic.smk"
    TARGETS.append("adapters/trimmomatic.done")

# rRNA filtering, SortMeRNA
if "sortmerna" in config:
    print("ADD: sortmerna")
    include:
        "rules/sortmerna.smk"
    TARGETS.append("sortmerna/sortmerna.done")

# reads filtering, reference genomes
if "genomes" in config:
    print("ADD: genomes")
    include:
        "rules/genomes.smk"
    TARGETS += expand(
        "filtering/{genome}.fa",
        genome=config["genomes"].keys()
    )

# taxonomy, Kraken2 databases
if "kraken2" in config:
    print("ADD: kraken2")
    include:
        "rules/kraken2.smk"
    TARGETS += flatten_list([expand(
        "{kdb}/{fname}",
        kdb=kdb, fname=get_kraken2db_file_names()
    ) for kdb in config["kraken2"].keys()])

# taxonomy, GTDBtk
# NOTE: big archive, many files
if "gtdbtk" in config:
    print("ADD: gtdbtk")
    include:
        "rules/gtdbtk.smk"
    TARGETS.append("gtdbtk")

# annotation, Mantis
if "mantis" in config:
    print("ADD: mantis")
    assert config["mantis"]["default"] or config["mantis"]["custom"], \
        "mantis in config but no default or custom databases given"
    include:
        "rules/mantis.smk"
    TARGETS.append("mantis/setup.done")

##################################################
# RULES

# Main rule
rule ALL:
    input:
        TARGETS
