##################################################
# MODULES

import os
import re
import pandas
from snakemake.utils import validate

# utils
include:
    "rules/common.smk"

# print(workflow.snakefile, workflow.basedir, workflow.conda_prefix)

##################################################
# CONFIG

# config validation
validate(config, srcdir("../schemas/schema.install.yaml"))

# paths
ENV_DIR = srcdir("envs")
SRC_DIR = srcdir("scripts")
CONDA_DIR = workflow.conda_prefix if workflow.conda_prefix else srcdir("../conda")
SUBMOD_DIR = srcdir("../submodules")
INSTALL_DIR = srcdir("")
MAIN_ENV_DIR = srcdir("../workflow/envs")

# default executable for snakemake
shell.executable("bash")

# working directory
workdir:
    config["db_path"]

##################################################
# TARGETS & RULES

include:
        "rules/binning.smk"

include:
        "rules/mummer4.smk"

include:
        "rules/motus.smk"

TARGETS = ["checkm/checkm_db.ready", os.path.join(SUBMOD_DIR, "binny/setup.done"), "SemiBin_setup.done",
           os.path.join(SUBMOD_DIR, "ESOM/setup.done"), "qm.ready", "motus_db_download.done"]

# adapters, Trimmomatic
if "trimmomatic" in config:
    include:
        "rules/trimmomatic.smk"
    TARGETS.append("adapters/trimmomatic.done")

# rRNA filtering, SortMeRNA
if "sortmerna" in config:
    include:
        "rules/sortmerna.smk"
    TARGETS.append("sortmerna/sortmerna.done")

# reads filtering, reference genomes
if "genomes" in config:
    include:
        "rules/genomes.smk"
    TARGETS += expand(
        "filtering/{genome}.fa",
        genome=config["genomes"].keys()
    )

# taxonomy, Kraken2 databases
if "kraken2" in config:
    include:
        "rules/kraken2.smk"
    TARGETS += flatten_list([expand(
        "{kdb}/{fname}",
        kdb=kdb, fname=get_kraken2db_file_names()
    ) for kdb in config["kraken2"].keys()])

# taxonomy, GTDBtk
# NOTE: big archive, many files
if "gtdbtk" in config:
    include:
        "rules/gtdbtk.smk"
    TARGETS.append("gtdbtk")

# annotation, Mantis
if "mantis" in config:
    assert config["mantis"]["default"] or config["mantis"]["custom"], \
        "mantis in config but no default or custom databases given"
    include:
        "rules/mantis.smk"
    TARGETS.append("mantis/setup.done")

##################################################
# RULES

# Main rule
localrules: ALL
rule ALL:
    input:
        TARGETS
