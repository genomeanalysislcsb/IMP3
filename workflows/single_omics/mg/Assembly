# include rules for the Assembly part of the workflow

# include needed rules
include:
    '../../../rules/Assembly/common/bwa.index.rules'

include:
    '../../../rules/Assembly/common/%s.rules' % IMP_ASSEMBLER

include:
    '../../../rules/Assembly/common/merge-assembly.rules'

include:
    '../../../rules/Assembly/single-omic/extract-unmapped.rules'

include:
    '../../../rules/Assembly/common/contig.rules'

include:
    '../../../rules/Assembly/common/mapping.rules'


master_ass_input = [
        'Assembly/intermediary.tar.gz',
        'Assembly/mg.assembly.merged.fa',
        'Assembly/mg.assembly.merged.fa.fai',
        'Assembly/mg.assembly.merged.fa.bed3',
        'Assembly/mg.reads.sorted.bam',
        'Assembly/mg.reads.sorted.bam.bai']

if MT:
    master_ass_input.append('Assembly/mt.reads.sorted.bam.bai')

# master command
rule ASSEMBLY:
    input:
        master_ass_input
    output:
        touch('assembly.done')
