if config['dereplication']['simple_derep']:
    include:
        "../../rules/Multi/Dereplicate/dRep.simple.rules"
if config['dereplication']['cross_mapping_rebinning']['do']:
    include:
        "../../rules/Multi/Dereplicate/cross_mapping.rules"
    include:
        "../../rules/Multi/Dereplicate/MetaBAT.rules"
    include:
        "../../rules/Multi/Dereplicate/MaxBin.rules"
    include:
        "../../rules/Multi/Dereplicate/dastool.rules"
    include:
        "../../rules/Multi/Dereplicate/dRep.multi.rules"
    if config['dereplication']['GTDBtk']:
        include:
            "../../rules/Multi/Dereplicate/gtdbtk_multi.rules"
    else:
        include:
            "../../rules/Multi/Dereplicate/dRep_sum.multi.rules"
else:
    if config['dereplication']['GTDBtk']:
        include:
            "../../rules/Multi/Dereplicate/gtdbtk_drep.rules"
    else:
        include:
            "../../rules/Multi/Dereplicate/dRep_sum.simple.rules"


# master command
rule all_derep:
    input:
        "Dereplication/all_bin_stats.tsv"
    output:
        touch('dereplicate.done')


