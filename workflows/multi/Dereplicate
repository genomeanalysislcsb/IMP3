if config['dereplication']['simple_derep']['do']:
    include:
        "../../rules/Multi/Dereplicate/dRep.simple.rules"
if config['dereplication']['cross_mapping_rebinning']['do']:
    include:
        "../../rules/Multi/Dereplicate/map.rules"
    include:
        expand("../../rules/Multi/Dereplicate/{binner}.rules",
              binner=config['dereplication']['cross_mapping_rebinning']['binners'].split())
    include:
        "../../rules/Multi/Dereplicate/dRep.multi.rules"
if config['dereplication']['GTDBtk']:
    include:
        "../../rules/Multi/Dereplicate/GTDBtk.rules"
include:
    "../../rules/Multi/Dereplicate/bin_stats.rules"


# master command
rule all_derep:
    input:
        "Dereplication/all_bin_stats.tsv"
    output:
        touch('collate.done')


