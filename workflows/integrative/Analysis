# master command
rule ANALYSIS:
    input:
        "Stats/%s/%s.assembly.length.txt" % ASS,
        "Stats/%s/%s.assembly.gc_content.txt" % ASS,
        "Analysis/%s.vizbin.filtered.fa" %ASS,
        "Analysis/%s.vizbin.with-contig-names.points" % ASS,
        expand("Stats/{type}/annotation/{type}.annotation.bed", type=TYPES),
        expand("Stats/{type}/annotation/{type}.gene_depth.hist", type=TYPES),
        expand("Stats/{type}/annotation/{type}.gene_depth.avg", type=TYPES),
        expand("Stats/{type}/annotation/{type}.gene.len", type=TYPES),
        expand("Stats/{type}/annotation/{type}.prokkaID2ec.txt", type=TYPES),
        expand("Stats/{type}/annotation/{type}.read_counts.txt", type=TYPES),
        expand("Stats/{type}/{type}.read_counts.txt", type=TYPES),
        expand("Analysis/snps/{type}.variants.samtools.vcf.gz", type=TYPES),
        expand("Analysis/taxonomy/kraken/{type}.kraken.output",type=TYPES),
        expand("Analysis/taxonomy/kraken/{type}.kraken.report",type=TYPES),
        "Analysis/taxonomy/kraken/%s.kraken.contig.output" % ASS,
        "Analysis/taxonomy/kraken/%s.kraken.parsed.tsv" % ASS,
        "Analysis/taxonomy/kraken/%s.kraken.contig.report" % ASS,
        "Analysis/taxonomy/mOTUs/{type}.mOTU.{measure}.tsv",type=TYPES,measure=["abundances","counts"]),
        expand("Stats/{type}/{type}.assembly.contig_coverage.txt",type=TYPES),
        expand("Stats/{type}/{type}.assembly.contig_depth.txt",type=TYPES),
        expand("Stats/{type}/{type}.assembly.contig_flagstat.txt",type=TYPES),
	"Analysis/annotation/annotation_CDS_RNA_hmms.gff",
        expand("Analysis/annotation/{type}.{feature}_counts.tsv",type=TYPES,feature=["rRNA","CDS"]),
        expand(""Analysis/annotation/{type}.{db}.counts.tsv",type=TYPES,db=config["hmmdbs"]),
	"Analysis/taxonomy/mOTU_links/bestPresentHitPhylogeny.tsv",
	"Analysis/taxonomy/mOTU_links/all.mOTUs.present",
