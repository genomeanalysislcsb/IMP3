# include rules for the Binning part of the workflow

## DAStool
include:
    '../../rules/Binning/DAStool/dastool.rules'

inputs_binning = ["Binning/selected_DASTool_summary.txt","Binning/GRiD.done"]

## MaxBin
if "MaxBin" in BIN_STEPS:
    inputs_binning.append("Binning/MaxBin/maxbin_res.log")
    include:
        '../../rules/Binning/MaxBin/maxbin.rules'
    include:
        '../../rules/Binning/MaxBin/maxbin_get_depth.rules'
    include:
        '../../rules/Binning/MaxBin/get_contig2bin.rules'
## MetaBAT
if "MetaBAT" in BIN_STEPS:
    inputs_binning.append("Binning/MetaBAT/metabat_res")
    include:
        '../../rules/Binning/MetaBAT/metabat.rules'

## binny
if "binny" in BIN_STEPS:
    inputs_binning.append("Binning/binny/scaffold2bin.tsv")
    include:
        '../../rules/Binning/binny/vizbin.rules'
    include:
        '../../rules/Binning/binny/binny.rules'
    include:
        '../../rules/Binning/binny/binny2dastool.rules'

## GRiD
include:
    '../../rules/Binning/GRiD/grid_dynamic.rules'

if not 'taxonomy' in IMP_STEPS:
    inputs_binning.append("Binning/selected_DASTool_bins/per_bin_results.tar.gz")



## master command
rule BINNING:
    input:
        inputs_binning
    output:
        touch('binning.done')
