# include rules for the Report part of the workflow
sum_target = []
if "stats" in SUM_STEPS:
    include:
        '../../rules/Summary/stats_gather.rules'
    sum_target.append("stats.done")
    if not "preprocessing" in IMP_STEPS and (MG or MT or MGaln or MTaln):
        include:
            '../../rules/Preprocessing/reads-count.rules'
        include:
            '../../rules/Summary/stats_preprocessing.rules'
    if not "assembly" in IMP_STEPS and CONTIGS:
        include:
            '../../rules/Assembly/common/contig-length.rules'
        include:
            '../../rules/Assembly/common/contig-depth.rules'
        include:
            '../../rules/Summary/stats_assembly.rules'

if "DB" in SUM_STEPS:
    include:
        '../../rules/Summary/mongoDB.rules'
    sum_target.append("DB_filling.done")


if "vis" in SUM_STEPS:
    sum_target.append("visualization.done")
    vis_targets = []
    if "stats" in SUM_STEPS:
        include:
            '../../rules/Summary/vis_stats.rules'
        vis_targets.append("stats.visualized")
    if "taxonomy" in IMP_STEPS and (MG or MT):
        include:
            '../../rules/Summary/vis_mOTUs.rules'
        include:
            '../../rules/Summary/vis_kraken_reads.rules'
        vis_targets.append("taxonomy.visualized")
    if "analysis" in IMP_STEPS:
        include:
            '../../rules/Summary/vis_functions.rules'
        include:
            '../../rules/Summary/vis_snps.rules'
    if "binning" in IMP_STEPS:
        include:
            '../../rules/Summary/vis_binning.rules'
    rule VIS:
        input:
            vis_targets
        output:
            touch('visualization.done')
            


