            if r.returncode == 0:
                return any(x.strip() in ("RUNNING", "COMPLETING", "PENDING", "CONFIGURING")
                           for x in r.stdout.splitlines())
    if host == socket.gethostname():
        try:
            os.kill(int(pid), 0)
            return True
        except ProcessLookupError:
            return False
        except (PermissionError, ValueError):
            return None
    return None


def cmd_status(a):
    s = load_settings(a.project)
    samples = discover_samples(s)
    rows = []
    for k in samples:
        out = os.path.join(s["project"], "imp", k)
        logs = sorted(glob.glob(os.path.join(s["project"], "imp_run_logs", "imp_%s_*.log" % k)))
        steps = sorted(os.path.basename(p)[:-5] for p in glob.glob(os.path.join(out, "status", "*.done")))
        sub = os.path.join(s["project"], "imp_run_logs", "imp_%s.submitted" % k)
        run = os.path.join(s["project"], "imp_run_logs", "imp_%s.running" % k)
        alive = master_alive(run) if os.path.exists(run) else False
        tail = open(logs[-1], errors="replace").read()[-20000:] if logs else ""
        errors = bool(re.search(r"Error in rule|WorkflowError|MissingInputException", tail))
        if os.path.exists(os.path.join(out, DONE)):
            st = "done"
        elif os.path.exists(sub) and (not logs or os.path.getmtime(sub) > os.path.getmtime(logs[-1])):
            st = "submitted"
        elif alive or (alive is None and os.path.exists(run)):
            # keep-going: a failed rule does not stop the master; 'running?' = master on another machine
            st = ("running" if alive else "running?") + ("+err" if errors else "")
        elif logs:
            st = "failed" if errors or "Exiting because a job execution failed" in tail else "stopped"
        else:
            st = "not started"
        rows.append((k, st, ",".join(x for x in steps if x not in ("all",)) or "-",
                     os.path.relpath(logs[-1], s["project"]) if logs else "-"))
    w = max([len(r[0]) for r in rows] + [6])
    print("%-*s  %-12s  %-60s  %s" % (w, "sample", "status", "steps done", "last log"))
    for r in rows:
        print("%-*s  %-12s  %-60s  %s" % (w, r[0], r[1], r[2][:60], r[3]))
    from collections import Counter
    c = Counter(r[1] for r in rows)
    print("\n" + ", ".join("%s %d" % (k, v) for k, v in sorted(c.items())))
    return 0


