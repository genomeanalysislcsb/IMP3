# ----------------------------------------------------------------------------------------------------------- containerize
def native_hash(prefix, content, deploy=None):
    """Snakemake 7 hash of a conda environment created on the host (snakemake/deployment/conda.py, Env.hash)"""
    m = hashlib.md5()
    m.update(os.path.realpath(prefix).encode())
    if deploy:
        m.update(deploy)
    m.update(content)
    return m.hexdigest()


def content_hash(content, deploy=None):
    """Snakemake 7 hash of a conda environment in a containerized image (Env.content_hash -> /conda-envs/<hash>)"""
    m = hashlib.md5()
    m.update(content)
    if deploy:
        m.update(deploy)
    return m.hexdigest()


def env_files(imp3_dir):
    """environment files of IMP3 and of the Snakemake modules it uses (binny in submodules/binny)"""
    out = []
    files = sorted(glob.glob(os.path.join(imp3_dir, "workflow", "envs", "*.yaml")))
    files += sorted(f for f in glob.glob(os.path.join(imp3_dir, "submodules", "**", "envs", "*.y*ml"), recursive=True)
                    if "/.snakemake/" not in f and "/test" not in f)
    for f in files:
        dep = os.path.splitext(f)[0] + ".post-deploy.sh"
        out.append((f, open(f, "rb").read(), open(dep, "rb").read() if os.path.exists(dep) else None))
    return out


def cmd_containerize(a):
    """Apptainer definition with the conda environments of an existing IMP3 installation (as tested on the cluster):
    copied unchanged to their original path in the image, linked from /conda-envs/<hash> where Snakemake looks for
    them in a containerized image. No relocation (conda-pack needs the package caches, which old installations often
    no longer have)."""
    prefix = os.path.realpath(a.envs)
    out = logical_abspath(a.output)
    mounts = [os.path.normpath(m) for m in re.split(r"[,\s]+", a.mounts or "") if m]
    bad = [m for m in mounts if not m.startswith("/") or m.split("/")[1] in ("dev", "proc", "sys", "etc", "usr", "bin",
                                                                            "lib", "lib64", "opt", "conda-envs")
           or any(src == m or src.startswith(m.rstrip("/") + "/") for src in [prefix])]
    if bad:
        sys.exit("imp3: --mounts: %s are system folders or contain the environments (%s); binding them at run time "
                 "would hide the environments" % (", ".join(bad), prefix))
    os.makedirs(os.path.join(out, "envs"), exist_ok=True)
    rows, missing = [], []
    for f, content, deploy in env_files(a.imp3_dir):
        h = native_hash(prefix, content, deploy)
        cand = [os.path.join(prefix, x) for x in (h, h[:8], h + "_")]
        found = next((c for c in cand if os.path.isdir(c) and os.path.exists(os.path.join(c, "conda-meta"))), None)
        target = content_hash(content, deploy)
        if found:
            rows.append((os.path.relpath(f, a.imp3_dir), found, target))
        else:
            missing.append(os.path.relpath(f, a.imp3_dir))
    if not rows:
        sys.exit("imp3: no IMP3 environment of %s found in %s (wrong prefix or IMP3 checkout?)" % (a.imp3_dir, prefix))
    with open(os.path.join(out, "envs.tsv"), "w") as fh:
        fh.write("env_file\tsource_env\tcontainer_env\n")
        for r in rows:
            fh.write("%s\t%s\t/conda-envs/%s\n" % r)
    # pack script: every environment as it is (tar keeps links and permissions), restored in the image at its original
    # path, so no path inside it has to change; /conda-envs/<hash> links to it (where Snakemake looks)
    pack = ["#!/bin/bash", "# packs the IMP3 conda environments for the container, unchanged (tar)", "set -euo pipefail",
            'cd "$(dirname "$0")"', "mkdir -p envs", ": > envs/links.tsv"]
    for name, src, target in rows:
        rel = src.lstrip("/")
        pack.append('[ -s envs/%s.tar ] || { tar -C / -cf envs/%s.tar.part %s && mv envs/%s.tar.part envs/%s.tar; }   # %s'
                    % (target, target, shlex.quote(rel), target, target, name))
        pack.append("printf '%%s\\t%%s\\n' %s %s >> envs/links.tsv" % (target, shlex.quote(src)))
        pack.append("cp %s envs/%s.environment.yaml" % (shlex.quote(os.path.join(a.imp3_dir, name)), target))
    with open(os.path.join(out, "pack_envs.sh"), "w") as fh:
        fh.write("\n".join(pack) + "\n")
    os.chmod(os.path.join(out, "pack_envs.sh"), 0o755)
    version = open(os.path.join(a.imp3_dir, "VERSION")).read().strip() if os.path.exists(
        os.path.join(a.imp3_dir, "VERSION")) else "?"
    envhash = hashlib.sha256(b"".join(c for _, c, _ in env_files(a.imp3_dir))).hexdigest()
    with open(os.path.join(out, "imp3.def"), "w") as fh:
        fh.write(DEF_TEMPLATE.format(base=a.base, version=version, envhash=envhash, mounts=" ".join(mounts),
                                     n=len(rows), date=datetime.date.today()))
    with open(os.path.join(out, "build.sh"), "w") as fh:
        fh.write(BUILD_SH.replace("__IMP3_DIR__", shlex.quote(a.imp3_dir)))
    os.chmod(os.path.join(out, "build.sh"), 0o755)
    say("%d environments -> %s (envs.tsv); not installed under the prefix: %s"
        % (len(rows), out, ", ".join(missing) or "none"))
    say("next: cd %s && ./build.sh   (packs the environments, then apptainer build imp3.sif imp3.def)" % out)
    return 0


DEF_TEMPLATE = r"""Bootstrap: docker
From: {base}

# IMP3 container: every conda environment of IMP3, as installed and tested on the cluster ({n} environments),
# unchanged at their original path, linked from /conda-envs/<hash> where Snakemake 7 looks for them in a
# containerized image. Do not bind a host folder over that original path at run time (on the cluster itself the
# same environments are there, so it does no harm). Databases, reads, the IMP3
# checkout and the project are bound at run time (imp3 run does that). Generated by 'imp3 containerize' on {date}.

%labels
    org.opencontainers.image.title IMP3
    org.opencontainers.image.version {version}
    org.opencontainers.image.source https://github.com/genomeanalysislcsb/IMP3
    io.github.snakemake.containerized true
    io.github.snakemake.conda_env_hash {envhash}
    imp3.mounts {mounts}

%files
    envs /opt/imp3-envs

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    # system tools the rules call outside their environments (imp3 tools lists them). Separate commands: with
    # 'a && b' a failing apt-get does not stop the build (set -e). Sandbox user root: fakeroot builds cannot switch
    # to the _apt user
    A="-o APT::Sandbox::User=root"
    apt-get $A update
    apt-get $A install -y --no-install-recommends rsync pigz parallel bc file unzip wget curl git procps less tree \
        ca-certificates
    rm -rf /var/lib/apt/lists/*
    # tools of the rules without their own environment (shell one-liners, python helpers), in their own environment:
    # installing them into base updates libraries that base's mamba / conda need
    /opt/conda/bin/conda create -y -p /opt/imp3-tools -c conda-forge -c bioconda python=3.11 pandas numpy pyyaml \
        biopython samtools seqkit && /opt/conda/bin/conda clean -a -y
    # mount points of the site's file systems (imp3 containerize --mounts): Apptainer without overlay skips a bind
    # whose destination does not exist in the image
    mkdir -p /conda-envs {mounts}
    # environments at their original path (unchanged), /conda-envs/<hash> -> original path
    while IFS="$(printf '\t')" read -r h src; do
        # fakeroot: the owners of the cluster (uids outside the build namespace) cannot be set; root owns them
        tar --no-same-owner -xf /opt/imp3-envs/$h.tar -C /
        chmod -R a+rX "$src"
        ln -sfn "$src" /conda-envs/$h
        cp /opt/imp3-envs/$h.environment.yaml "$src/environment.imp3.yaml"
        rm -f /opt/imp3-envs/$h.tar
    done < /opt/imp3-envs/links.tsv
    rm -rf /opt/imp3-envs

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/opt/imp3-tools/bin:/opt/conda/bin:$PATH

%test
    test -d /conda-envs && ls /conda-envs | head
    /opt/conda/bin/conda --version
    for c in rsync pigz parallel bc file unzip wget curl git tree; do command -v $c >/dev/null || {{ echo "missing $c"; exit 1; }}; done

%help
    IMP3 container. Run IMP3 with 'imp3 run' (container: /path/to/imp3.sif in imp3.yaml), or directly:
    snakemake ... --use-conda --use-singularity --singularity-args "--nv --bind <db>,<reads>,<imp3>,<project>"
    with 'container: /path/to/imp3.sif' in the IMP3 config.
"""

BUILD_SH = r"""#!/bin/bash
# 1) pack the conda environments (tar), 2) build the image. Needs apptainer (or singularity) with
# --fakeroot or root. Space: about twice the size of the environments in this folder and in APPTAINER_TMPDIR.
set -euo pipefail
cd "$(dirname "$0")"
APP=$(command -v apptainer || command -v singularity || true)
if [ -z "$APP" ]; then
    echo "build.sh: neither apptainer nor singularity found in PATH (module load it first, e.g. module load tools/Apptainer)" >&2
    exit 1
fi
echo "packing the environments (pack_envs.sh) ..."
./pack_envs.sh
echo "building imp3.sif with $APP ..."
export APPTAINER_TMPDIR=${APPTAINER_TMPDIR:-$PWD/tmp}; mkdir -p "$APPTAINER_TMPDIR"
$APP build ${BUILD_ARGS:---fakeroot} imp3.sif imp3.def
# third-party code IMP3 reads on the host (binny module, its database, ESOM, forks): ship with the image
if [ -d __IMP3_DIR__/submodules ]; then
    tar -czf imp3_submodules.tar.gz -C __IMP3_DIR__ submodules
    echo "other sites: tar -xzf imp3_submodules.tar.gz -C /path/to/IMP3"
fi
echo "built $(pwd)/imp3.sif"
"""


# ----------------------------------------------------------------------------------------------------------- tools
SH_BUILTINS = set("""if then else elif fi for while until do done case esac in function return exit break continue
echo printf cd export source . set unset local read shift test [ [[ ] ]] true false eval exec trap wait time declare
typeset let alias ulimit umask pwd command type hash readonly getopts mapfile : ! { } ( ) shopt select""".split())


def rule_blocks(text):
    """(rule name, body) of every rule / checkpoint of a Snakemake file (also indented ones, e.g. in if blocks)"""
    parts = re.split(r"\n[ \t]*(?:rule|checkpoint)\s+(\w+)\s*:", "\n" + text)
    return [(parts[i], parts[i + 1]) for i in range(1, len(parts), 2)]


def rule_shell(body, text=""):
    m = re.search(r"\n\s*shell:\s*\n?\s*[rf]?(\"\"\"|''')(.*?)\1", body, re.S)
    if m:
        return m.group(2)
    m = re.search(r"\n\s*shell:\s*[rf]?(\"|')(.*?)(?<!\\)\1", body, re.S)
    if m:
        return m.group(2)
    m = re.search(r"\n\s*shell:\s*\n?\s*([A-Za-z_]\w*)\s*\n", body + "\n")      # shell: NAME (a string of the file)
    if m:
        v = re.search(r"(?m)^%s\s*=\s*[rf]?(\"\"\"|''')(.*?)\1" % m.group(1), text, re.S)
        return v.group(2) if v else None
    return None


def rule_env(body):
    m = re.search(r"\n\s*conda:\s*\n?\s*(.+)", body)
    if not m:
        return None
    f = re.search(r"[\"']([\w.\-/]+\.ya?ml)[\"']", m.group(1))
    return os.path.basename(f.group(1)) if f else None


def shell_commands(sh):
    """programs a rule's shell block calls (heuristic: the first word of every command, without shell built-ins,
    functions defined in the block, variables, paths and Snakemake placeholders)"""
    sh = re.sub(r"\\\n", " ", sh)
    funcs = set(re.findall(r"(?:^|\n)\s*(?:function\s+)?(\w+)\s*\(\)\s*\{", sh))
    sh = re.sub(r"<<-?\s*['\"]?(\w+)['\"]?.*?\n\s*\1\s*(\n|$)", "\n", sh, flags=re.S)       # here documents
    sh = re.sub(r"(?m)^\s*#.*$", "", sh)
    sh = re.sub(r"'[^'\n]*'", "''", sh)
    # double-quoted text (echo messages): only its command substitutions count
    sh = re.sub(r"\"([^\"\n]*)\"", lambda m: " ; ".join(re.findall(r"\$\(([^)]*)\)", m.group(1))) or "\"\"", sh)
    cmds = set()
    for seg in re.split(r"\n|\|\||&&|\||;|\$\(|`|\bthen\b|\bdo\b|\belse\b|\(|\)", sh):
        toks = seg.strip().split()
        while toks and (re.match(r"^\w+=", toks[0]) or toks[0] in ("!", "time", "nice", "exec", "command", "env")):
            toks = toks[1:]
        if not toks:
            continue
        w = toks[0]
        if (w in SH_BUILTINS or w in funcs or "/" in w or "{" in w or w.startswith(("$", "-", ".")) or w.isdigit()
                or not re.match(r"^[A-Za-z0-9_][A-Za-z0-9_.+\-]*$", w) or w.endswith(".")):
            continue
        cmds.add(w)
    return cmds


def rule_tools(imp3_dir):
    """{environment file name or None (no environment): {program: [rules]}}"""
    files = glob.glob(os.path.join(imp3_dir, "workflow", "**", "*.smk"), recursive=True)
    files += [os.path.join(imp3_dir, "Snakefile")]
    out = {}
    for f in sorted(files):
        text = open(f, errors="replace").read()
        for name, body in rule_blocks(text):
            sh = rule_shell(body, text)
            if sh:
                env = rule_env(body)
                for c in shell_commands(sh):
                    out.setdefault(env, {}).setdefault(c, []).append(name)
    return out


def cmd_tools(a):
    """checks that every program the rules call is in the container: in the rule's environment, or (no environment
    or not in it) on the image's PATH"""
    imp3_dir = os.path.abspath(a.imp3_dir)
    tools = rule_tools(imp3_dir)
    envs = {os.path.basename(f): "/conda-envs/" + content_hash(c, d) for f, c, d in env_files(imp3_dir)}
    if a.list:
        for env in sorted(tools, key=lambda x: x or ""):
            print("%s\t%s" % (env or "-", " ".join(sorted(tools[env]))))
        return 0
    sif = a.container
    s = {"pre_commands": []}
    if not sif:
        s = load_settings(a.project)
        sif = s.get("container")
    if not sif:
        sys.exit("imp3 tools: no container (--container, or container: in imp3.yaml of the project)")
    lines = ["base_missing=''"]
    for env in sorted(tools, key=lambda x: x or ""):
        cmds = " ".join(sorted(tools[env]))
        if env is None:
            lines.append("for c in %s; do command -v \"$c\" >/dev/null || echo \"MISSING - $c\"; done" % cmds)
            continue
        path = envs.get(env)
        if not path:
            lines.append("echo 'UNKNOWN %s'" % env)
            continue
        lines.append("if [ -d %s ]; then ( source /opt/conda/bin/activate %s >/dev/null 2>&1; for c in %s; do "
                     "command -v \"$c\" >/dev/null || echo \"MISSING %s $c\"; done ); else echo 'NOENV %s'; fi"
                     % (path, path, cmds, env, env))
    lines.append("echo IMP3_TOOLS_CHECKED")
    script = "\n".join(lines)
    line = ('APP=$(command -v apptainer || command -v singularity) && "$APP" -s exec %s bash -c %s'
            % (shlex.quote(sif), shlex.quote(script)))
    r = subprocess.run(["bash", "-c", shell_line(s, ["true"]) + " && " + line], stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, universal_newlines=True)
    if "IMP3_TOOLS_CHECKED" not in r.stdout:
        sys.exit("imp3 tools: could not run the container %s:\n%s" % (sif, (r.stderr or r.stdout)[-2000:]))
    missing, noenv = {}, []
    for x in r.stdout.splitlines():
        p = x.split()
        if p[:1] == ["MISSING"]:
            missing.setdefault(p[1], []).append(p[2])
        elif p[:1] in (["NOENV"], ["UNKNOWN"]):
            noenv.append(p[1])
    n = sum(len(v) for v in tools.values())
    if noenv:
        say("environments not in the image (their rules cannot run in it): %s" % ", ".join(sorted(noenv)))
    for env in sorted(missing):
        for c in sorted(missing[env]):
            rules = tools[None if env == "-" else env][c]
            say("missing %-28s %-22s rules: %s" % (c, "(no environment)" if env == "-" else "(" + env + ")",
                                                   ", ".join(sorted(set(rules))[:4])))
    say("%d program calls checked in %s: %d missing%s" % (
        n, sif, sum(len(v) for v in missing.values()),
        "" if not missing else " (some may be shell functions or words the scan took for programs; check the rule)"))
    return 1 if missing else 0


# ----------------------------------------------------------------------------------------------------------- main
def main(argv=None):
    ap = argparse.ArgumentParser(prog="imp3", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("init", help="create a project folder (settings, sample config template, Snakemake profile)")
    p.add_argument("project")
    p.add_argument("--executor", choices=("slurm", "local"), default="slurm")
    p.add_argument("--site", default="generic", help="Slurm cluster config: generic | ulhpc (profiles/slurm/cluster.<site>.yaml)")
    p.add_argument("--container", default="", help="IMP3 .sif: run every rule in the container")
    p.add_argument("--conda-prefix", default="", help="conda environments of IMP3 (native runs)  [IMP3/conda]")
    p.add_argument("--db", default="", help="IMP3 database folder")
    p.add_argument("--config-template", default="", help="your IMP3 config template (with __SAMPLE__ etc.)")
    p.add_argument("--cores", type=int, default=0, help="slurm: total cores of all jobs of one sample [128]")
    p.add_argument("--jobs", type=int, default=0, help="slurm: jobs of one sample at the same time [50]")
    p.add_argument("--force", action="store_true")
    p = sub.add_parser("run", help="run IMP3 for the samples that are not finished")
    p.add_argument("-p", "--project", default=".")
    p.add_argument("--samples", default="", help="only these samples (comma-separated)")
    p.add_argument("-j", "--jobs", type=int, default=0, help="samples at the same time [parallel_samples]")
    p.add_argument("--submit", action="store_true", help="submit every sample's master as a Slurm job (no tmux)")
    p.add_argument("--foreground", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("-n", "--dry-run", action="store_true", help="show what would run")
    p.add_argument("--force", action="store_true", help="also samples with status/all.done")
    p.add_argument("extra", nargs=argparse.REMAINDER, help="after --: extra Snakemake options, e.g. -- --until assembly")
    p = sub.add_parser("status", help="state of every sample")
    p.add_argument("-p", "--project", default=".")
    p = sub.add_parser("tools", help="check that the programs the rules call are in the container")
    p.add_argument("-p", "--project", default=".")
    p.add_argument("--container", default="", help="the .sif to check  [container: of the project]")
    p.add_argument("--imp3-dir", default=IMP3_DIR, help="IMP3 checkout whose rules are scanned")
    p.add_argument("--list", action="store_true", help="only list the programs per environment (no container)")
    p = sub.add_parser("containerize", help="Apptainer definition from the conda environments of an installation")
    p.add_argument("--envs", required=True, help="conda prefix of the IMP3 environments (as in the Snakemake profile)")
    p.add_argument("--imp3-dir", default=IMP3_DIR, help="IMP3 checkout the environments belong to")
    p.add_argument("-o", "--output", default="imp3_container", help="build folder")
    p.add_argument("--base", default="condaforge/miniforge3:24.11.3-0", help="base image (docker)")
    p.add_argument("--mounts", default="", help="mount points of your site's file systems to create in the image, "
                   "e.g. /work/projects,/scratch/users (needed where Apptainer has no overlay; then list them under "
                   "container_mounts in imp3.yaml)")
    a = ap.parse_args(argv)
    if getattr(a, "extra", None):
        if a.extra[:1] != ["--"]:
            ap.error("unexpected %r: Snakemake options go after '--' (imp3 run -- --until assembly); "
                     "did you mean --%s?" % (" ".join(a.extra), a.extra[0].lstrip("-")))
        a.extra = a.extra[1:]
    if not a.cmd:
        ap.print_help()
        return 0
    return {"init": cmd_init, "run": cmd_run, "status": cmd_status, "containerize": cmd_containerize,
            "tools": cmd_tools}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
