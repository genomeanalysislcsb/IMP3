# include configuration file
include:
    "rules/ini/config"



rule all:
	input:
		'taxonomy.done'

MG = os.environ.get("MG", config['raws']['Metagenomics']).split()
MT = os.environ.get("MT", config['raws']['Metatranscriptomics']).split()

if MG and MT:
	TYPES = ['mg', 'mt']
	ASS = 'mgmt'
elif MG:
	TYPES = ['mg']
	ASS = 'mg'
elif MT:
	TYPES = ['mt']
	ASS = 'mt'

