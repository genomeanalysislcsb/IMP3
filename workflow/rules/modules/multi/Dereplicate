binctrl = []
if config['dereplication']['simple_derep']:
    include:
        "../../Multi/Dereplicate/dRep.simple.rules"
    include:
            "../../Multi/Dereplicate/dRep_sum.simple.rules"
    binctrl.append("Dereplication/dereplicated_bin_stats.tsv")
if config['dereplication']['cross_mapping_rebinning']['do']:
    include:
        "../../Multi/Dereplicate/cross_mapping.rules"
    include:
        "../../Multi/Dereplicate/MetaBAT.rules"
    include:
        "../../Multi/Dereplicate/MaxBin.rules"
    include:
        "../../Multi/Dereplicate/dastool.rules"
    include:
        "../../Multi/Dereplicate/grid.rules"
    include:
        "../../Multi/Dereplicate/dRep.multi.rules"
    binctrl.append("Dereplication/rebinned_bin_stats.tsv")
    if config['dereplication']['GTDBtk']:
        include:
            "../../Multi/Dereplicate/gtdbtk_multi.rules"
    else:
        include:
            "../../Multi/Dereplicate/dRep_sum.multi.rules"


# master command
rule all_derep:
    input:
        binctrl
    output:
        touch('status/dereplicate.done')


